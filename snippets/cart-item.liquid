{%- liquid
  assign theme_st = settings
  assign show_add_cart = theme_st.show_add_cart
  assign hidden_price = theme_st.hidden_price
  assign show_message_when_remove = theme_st.show_message_when_remove
  assign show_currency_code = theme_st.show_currency_code
  assign show_quantity = theme_st.show_quantity_input
  assign enable_shipping_protection = theme_st.enable_shipping_protection
  assign choose_shipping_protection_product = all_products[theme_st.choose_shipping_protection_product]
  assign shipping_protection_product_id = choose_shipping_protection_product.id
  assign is_shipping_protection_item = false
  if enable_shipping_protection and shipping_protection_product_id == item.product_id
    assign is_shipping_protection_item = true
  endif
  assign is_gift_progress_item = false
  for property in item.properties
    if property.first == '_brk_gift_progress' and property.last == 'true'
      assign is_gift_progress_item = true
    endif
  endfor

  comment
    BRK Bundles (lê o metafield `live` do app):
    - Isenção com "Mostrar desconto do add-on no carrinho" (só visual): o desconto
      real fica no(s) produto(s) do bundle, numa alocação com o label do add-on como
      título. Aqui ele some desses produtos e aparece nas linhas do add-on: o total
      de cada label é repartido entre elas na ordem do carrinho. Desconto misto (com
      brinde que não tem "Mostrar desconto") fica com a exibição normal.
    - brk_max: quantas unidades a linha do add-on ainda aceita com desconto (o JS do
      carrinho manda o excedente para uma linha sem o bundle). Com "Limite por
      produto do bundle", o máximo vale por unidade dos produtos que puxaram o add-on.
  endcomment
  assign brk_final = item.final_price
  assign brk_final_line = item.final_line_price
  assign brk_hide_titles = '|'
  assign brk_addon_title = ''
  assign brk_addon_amount = 0
  assign brk_limited = false
  assign brk_max = 0
  assign brk_live = shop.metafields.brk_bundles.live.value
  if brk_live
    assign brk_own_bundle = item.properties['_brk_bundle']
    assign brk_own_item = item.properties['_brk_bundle_item'] | append: ''
    assign brk_own_label = ''
    assign brk_per = 0
    assign brk_per_trigger = false
    if brk_own_bundle != blank
      for brk_b in brk_live
        if brk_b.id != brk_own_bundle
          continue
        endif
        for brk_a in brk_b.addons
          assign brk_a_pid = brk_a.productId | append: ''
          if brk_a_pid != brk_own_item
            continue
          endif
          assign brk_per = 1
          if brk_a.maxQty != nil and brk_a.maxQty != ''
            assign brk_per = brk_a.maxQty | plus: 0
          endif
          if brk_b.limitPerTrigger
            assign brk_per_trigger = true
          endif
          if brk_b.exemption and brk_b.showAddonDiscount
            assign brk_own_label = brk_a.label | default: brk_a.title | default: 'Bundle'
            if brk_a.mode == 'percent'
              assign brk_own_label = brk_own_label | replace: '{{brk_discount_percentage}}', brk_a.value
            elsif brk_a.mode == 'fixed'
              assign brk_own_label = brk_own_label | replace: '{{brk_discount_flat}}', brk_a.value
            endif
          endif
        endfor
      endfor
    endif

    comment
      Uma passada no carrinho: labels exibidos no add-on (brk_labels), gatilhos do
      mesmo bundle (brk_triggers), unidades do mesmo add-on em outras linhas e o
      quanto as linhas anteriores com o mesmo label já consomem do total (brk_before).
    endcomment
    assign brk_labels = '|'
    assign brk_triggers = '|'
    assign brk_other_units = 0
    assign brk_before = 0
    assign brk_seen_self = false
    for brk_line in cart.items
      if brk_line.key == item.key
        assign brk_seen_self = true
      endif
      assign brk_line_bundle = brk_line.properties['_brk_bundle']
      if brk_line_bundle == blank
        continue
      endif
      assign brk_line_item = brk_line.properties['_brk_bundle_item'] | append: ''
      if brk_line_bundle == brk_own_bundle
        assign brk_line_trigger = brk_line.properties['_brk_bundle_trigger'] | append: ''
        assign brk_triggers = brk_triggers | append: brk_line_trigger | append: '|'
        if brk_line_item == brk_own_item and brk_line.key != item.key
          assign brk_other_units = brk_other_units | plus: brk_line.quantity
        endif
      endif
      for brk_b in brk_live
        if brk_b.id != brk_line_bundle
          continue
        endif
        unless brk_b.exemption and brk_b.showAddonDiscount
          continue
        endunless
        for brk_a in brk_b.addons
          assign brk_a_pid = brk_a.productId | append: ''
          if brk_a_pid != brk_line_item
            continue
          endif
          assign brk_lbl = brk_a.label | default: brk_a.title | default: 'Bundle'
          if brk_a.mode == 'percent'
            assign brk_lbl = brk_lbl | replace: '{{brk_discount_percentage}}', brk_a.value
          elsif brk_a.mode == 'fixed'
            assign brk_lbl = brk_lbl | replace: '{{brk_discount_flat}}', brk_a.value
          endif
          assign brk_labels = brk_labels | append: brk_lbl | append: '|'
          if brk_seen_self == false and brk_lbl == brk_own_label
            assign brk_before = brk_before | plus: brk_line.final_line_price
          endif
        endfor
      endfor
    endfor

    if brk_per > 0
      assign brk_limited = true
      assign brk_allowed = brk_per
      if brk_per_trigger
        assign brk_units = 0
        for brk_line in cart.items
          if brk_line.properties['_brk_bundle'] != blank
            continue
          endif
          assign brk_needle = '|' | append: brk_line.product_id | append: '|'
          if brk_triggers contains brk_needle
            assign brk_units = brk_units | plus: brk_line.quantity
          endif
        endfor
        assign brk_allowed = brk_per | times: brk_units
      endif
      assign brk_max = brk_allowed | minus: brk_other_units | at_least: 0
    endif

    if brk_own_bundle != blank
      if brk_own_label != ''
        assign brk_total = 0
        for brk_line in cart.items
          if brk_line.properties['_brk_bundle'] != blank
            continue
          endif
          for brk_alloc in brk_line.line_level_discount_allocations
            assign brk_parts = brk_alloc.discount_application.title | split: ' + '
            unless brk_parts contains brk_own_label
              continue
            endunless
            assign brk_all_shown = true
            for brk_part in brk_parts
              assign brk_needle = '|' | append: brk_part | append: '|'
              unless brk_labels contains brk_needle
                assign brk_all_shown = false
              endunless
            endfor
            if brk_all_shown
              assign brk_total = brk_total | plus: brk_alloc.amount
            endif
          endfor
        endfor
        assign brk_addon_amount = brk_total | minus: brk_before | at_least: 0 | at_most: item.final_line_price
        if brk_addon_amount > 0
          assign brk_addon_title = brk_own_label
          assign brk_final_line = item.final_line_price | minus: brk_addon_amount
          assign brk_final = brk_final_line | divided_by: item.quantity
        endif
      endif
    elsif brk_labels != '|'
      assign brk_restore = 0
      for brk_alloc in item.line_level_discount_allocations
        assign brk_parts = brk_alloc.discount_application.title | split: ' + '
        assign brk_all_shown = true
        for brk_part in brk_parts
          assign brk_needle = '|' | append: brk_part | append: '|'
          unless brk_labels contains brk_needle
            assign brk_all_shown = false
          endunless
        endfor
        if brk_all_shown
          assign brk_restore = brk_restore | plus: brk_alloc.amount
          assign brk_hide_titles = brk_hide_titles | append: brk_alloc.discount_application.title | append: '|'
        endif
      endfor
      if brk_restore > 0
        assign brk_final_line = item.final_line_price | plus: brk_restore
        assign brk_final = brk_final_line | divided_by: item.quantity
      endif
    endif
  endif
-%}
<div
  id="minicart__product-{{ item.key }}"
  product-handle="{{ item.product.handle }}"
  data-shipping-protection-item="{{ is_shipping_protection_item }}"
  data-gift-progress-item="{{ is_gift_progress_item }}"
  data-shipping-protection-key="{{ item.key }}"
  data-shipping-protection-quantity="{{ item.quantity }}"
  {% if brk_limited %}data-brk-max="{{ brk_max }}" data-brk-variant="{{ item.variant_id }}"{% endif %}
  class="cart-item{% if is_gift_progress_item %} cart-item--gift-progress{% endif %}{% if item.parent_relationship %} cart-item--child{% endif %} flex mb-20 pb-20 gap-15 border-bottom-dashed"
>
  <div class="minicart__product__image global-media-settings w-custom fs-0 relative" style="--custom-width: 8rem">
    <a href="{{- item.url -}}" class="rounded-5 fs-0 block" aria-label="{{ item.product.title | escape }}" style="--aspect-ratio: 1/1;">
      {%- if item.image != blank -%}
        {%- assign image_alt = item.image.alt | default: item.product.title | escape -%}
        {% render 'responsive-image',
          type: 'product',
          image: item.image,
          image_alt: image_alt,
          class: 'rounded-5',
          custom_widths: '550, 480, 360, 160, 90',
          no_animate: true,
          lazy_product: false
        %}
      {%- else -%}
        {% render 'placeholder-render', class: 'rounded-5 img-item' %}
      {%- endif -%}
    </a>
  </div>
  <div class="minicart__product-info flex-1 relative">
    <div class="minicart__header flex justify-between align-start gap-10">
      <div class="minicart__header-left flex-1 min-w-0">
        <h3 class="minicart__product-name my-0 text-size">
          <a class="no-underline heading-color" href="{{- item.url -}}" aria-label="{{ item.product.title | escape }}">
            {{- item.product.title | escape -}}
          </a>
        </h3>
        {% if is_gift_progress_item %}
          <span class="cart-item__gift-badge">Brinde</span>
        {% endif %}
        <div class="minicart__item-variant cart-options flex flex-wrap">
          {%- unless item.product.has_only_default_variant or is_gift_progress_item -%}
            {%- for option in item.options_with_values -%}
              <div class="product-option dark-grey fs-small">
                <span class="label">{{ option.name }}: </span>
                <span class="uppercase-first-letter inline-block">{{ option.value }}</span>
              </div>
            {%- endfor -%}
          {%- endunless -%}
          {%- if item.properties.size != 0 -%}<div class="product-option-property">{%- endif -%}
          {%- for property in item.properties -%}
            {%- assign property_first_char = property.first | slice: 0 -%}
            {%- if property.last != blank and property_first_char != '_' -%}
              <div class="product-option">
                <span>{{ property.first }}: </span>
                <span>
                  {%- if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}" class="link" target="_blank">
                      {{ property.last | split: '/' | last }}
                    </a>
                  {%- else -%}
                    {{ property.last }}
                  {%- endif -%}
                </span>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if item.properties.size != 0 -%}</div>{%- endif -%}
        </div>
      </div>
      {% if hidden_price == false %}
        <div class="minicart__item-prices flex flex-column align-end flex-shrink-0">
          {%- assign current_variant = item.variant -%}
          {%- if item.original_price != brk_final -%}
            <span class="minicart__item-price heading_weight primary-color">
              {% if show_currency_code %}{{ brk_final | money_with_currency }}{% else %}{{ brk_final | money }}{% endif %}
            </span>
            <s class="minicart__item-original-price fs-small">
              {% if show_currency_code %}{{ item.original_price | money_with_currency }}{% else %}{{ item.original_price | money }}{% endif %}
            </s>
          {%- elsif current_variant.compare_at_price > current_variant.price -%}
            <span class="minicart__item-price heading_weight primary-color">
              {% if show_currency_code %}{{ current_variant.price | money_with_currency }}{% else %}{{ current_variant.price | money }}{% endif %}
            </span>
            <s class="minicart__item-original-price fs-small">
              {% if show_currency_code %}{{ current_variant.compare_at_price | money_with_currency }}{% else %}{{ current_variant.compare_at_price | money }}{% endif %}
            </s>
          {%- else -%}
            <span class="minicart__item-price heading-style">
              {% if show_currency_code %}{{ item.original_price | money_with_currency }}{% else %}{{ item.original_price | money }}{% endif %}
            </span>
          {%- endif -%}
        </div>
      {% endif %}
    </div>
    <ul
      class="discounts list-unstyled fs-small light-dark-grey"
      role="list"
      aria-label="{{ 'customer.order.discount' | t }}"
    >
      {%- if brk_addon_amount > 0 -%}
        <li class="discounts__discount fs-14 inline-flex align-center gap-5">
          <svg
            aria-hidden="true"
            focusable="false"
            class="icon icon-discount w-custom"
            style="--custom-width: 12px;"
            viewBox="0 0 12 12"
          >
            <path fill-rule="evenodd" clip-rule="evenodd" d="M7 0h3a2 2 0 012 2v3a1 1 0 01-.3.7l-6 6a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4l6-6A1 1 0 017 0zm2 2a1 1 0 102 0 1 1 0 00-2 0z" fill="currentColor">
          </svg>
          {{ brk_addon_title }}
          (-{{ brk_addon_amount | money }})
        </li>
      {%- endif -%}
      {%- for discount in item.line_level_discount_allocations -%}
        {%- assign brk_needle = '|' | append: discount.discount_application.title | append: '|' -%}
        {%- if brk_hide_titles contains brk_needle -%}{%- continue -%}{%- endif -%}
        <li class="discounts__discount fs-14 inline-flex align-center gap-5">
          <svg
            aria-hidden="true"
            focusable="false"
            class="icon icon-discount w-custom"
            style="--custom-width: 12px;"
            viewBox="0 0 12 12"
          >
            <path fill-rule="evenodd" clip-rule="evenodd" d="M7 0h3a2 2 0 012 2v3a1 1 0 01-.3.7l-6 6a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4l6-6A1 1 0 017 0zm2 2a1 1 0 102 0 1 1 0 00-2 0z" fill="currentColor">
          </svg>
          {{ discount.discount_application.title }}
          (-{{ discount.amount | money }})
        </li>
      {%- endfor -%}
    </ul>
    <div
      class="cart-item__error inline-flex align-start"
      id="CartDrawer-LineItemError-{{ item.key }}"
      role="alert"
    >
      <span class="cart-item__error-text cart-item__error-text-{{ item.id }}"></span>
      {%- render 'icon-error' -%}
    </div>
    {% comment %} Quantidade/remover no carrinho independem de show_quantity_input (esse setting controla só a PDP) {% endcomment %}
    {% if theme_st.enable_catalog_mode == false %}
    {% if is_gift_progress_item %}
      <div class="minicart__actions-row">
        <span class="cart-item__gift-qty">Qtd. {{ item.quantity }}</span>
      </div>
    {% elsif is_shipping_protection_item == false %}
      <div class="minicart__actions-row">
        <quantity-input class="quantity rounded-3 border inline-flex text-center grey-bg">
          <button
            class="quantity__button pointer border-0 no-js-hidden w-custom grey-bg inline-flex content-center ps-15 pe-5"
            name="minus"
            type="button"
            data-id="{{- item.key -}}"
            style="--custom-width: 2.6rem"
            arial-label="minus"
          >
            <svg width="9" height="1" fill="none">
              <path fill="#111" d="M9 0v1H0V0h9Z"/>
            </svg>
          </button>
          <label class="visually-hidden" for="{{- item.key -}}">
            {{ 'general.cart.headings.quantity' | t }}
          </label>
          <input
            class="quantity-input bg-unset text-center appearance-none p-0-important w-custom"
            type="number"
            id="{{- item.key -}}"
            name="updates[]"
            data-id="{{- item.key -}}"
            value="{{- item.quantity -}}"
            data-value="{{- item.quantity -}}"
            min="0"
            style="--input-padding: 0;--inputs-border-width: 0;--input-height: 30px;--custom-width: 3.2rem;--input-border-radius: 0;--input-bg: transparent"
          >
          <button
            class="quantity__button pointer border-0 no-js-hidden w-custom grey-bg pe-12"
            name="plus"
            type="button"
            data-id="{{- item.key -}}"
            style="--custom-width: 2.6rem"
            arial-label="plus"
          >
            <svg width="9" height="9" fill="none">
              <path fill="#111" fill-rule="evenodd" d="M4 9h1V5h4V4H5V0H4v4H0v1h4v4Z" clip-rule="evenodd"/>
            </svg>
          </button>
        </quantity-input>
        <svg hidden>
          <symbol id="icon-trash">
            <path fill="currentColor" d="M10.5 4.25h-7v7.588c0 .073.014.146.041.219a.727.727 0 0 0 .137.191.416.416 0 0 0 .177.123c.073.027.15.041.233.041h5.824c.082 0 .16-.014.232-.04a.416.416 0 0 0 .178-.124.53.53 0 0 0 .123-.191.485.485 0 0 0 .055-.22V4.25Zm-.588-1.162h2.338c.164 0 .3.06.41.178a.52.52 0 0 1 .178.396c0 .164-.06.305-.178.424a.557.557 0 0 1-.41.164h-.588v7.588c0 .237-.046.465-.137.684-.09.21-.214.391-.369.546a1.615 1.615 0 0 1-.56.383c-.21.091-.438.137-.684.137H4.088c-.246 0-.474-.05-.684-.15a1.931 1.931 0 0 1-.56-.37 1.755 1.755 0 0 1-.37-.546 1.76 1.76 0 0 1-.136-.684V4.25H1.75a.603.603 0 0 1-.424-.164.603.603 0 0 1-.164-.424.54.54 0 0 1 .164-.396.579.579 0 0 1 .424-.178h2.338V2.5c0-.237.045-.46.137-.67.09-.219.214-.406.369-.56.155-.165.337-.292.547-.383.218-.091.45-.137.697-.137h2.324c.246 0 .474.046.684.137.21.09.396.218.56.383.155.154.278.341.37.56.09.21.136.433.136.67v.588Zm-4.662 0h3.5V2.5a.433.433 0 0 0-.055-.219.531.531 0 0 0-.123-.191.416.416 0 0 0-.177-.123.513.513 0 0 0-.233-.055H5.838a.513.513 0 0 0-.233.055.416.416 0 0 0-.177.123.73.73 0 0 0-.137.191.55.55 0 0 0-.041.219v.588Zm0 3.5c0-.164.055-.3.164-.41A.579.579 0 0 1 5.838 6a.52.52 0 0 1 .396.178c.119.11.178.246.178.41v3.5c0 .155-.06.292-.178.41a.54.54 0 0 1-.396.164.603.603 0 0 1-.424-.164.587.587 0 0 1-.164-.41v-3.5Zm2.338 0c0-.164.055-.3.164-.41a.563.563 0 0 1 .82 0c.119.11.178.246.178.41v3.5c0 .155-.06.292-.178.41a.556.556 0 0 1-.41.164.587.587 0 0 1-.41-.164.587.587 0 0 1-.164-.41v-3.5Z"/>
          </symbol>
          <symbol id="icon-edit">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" d="m7.736 2.1-4.79 5.07a1.78 1.78 0 0 0-.39.834l-.216 1.89c-.076.682.414 1.149 1.09 1.032l1.879-.32c.262-.047.63-.24.81-.438l4.79-5.07c.828-.874 1.202-1.872-.088-3.091C9.538.799 8.564 1.225 7.736 2.1Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" d="M6.936 2.946a3.574 3.574 0 0 0 3.179 3.004M1.75 12.833h10.5"/>
          </symbol>
        </svg>
          {% assign item_url = item.url %}
          {%- unless item.product.has_only_default_variant or is_gift_progress_item -%}
            {% if theme_st.enable_catalog_mode == false and theme_st.enable_cart_item_edit %}
              <minicart-item-edit
                data-text-header="{{ 'general.cart.cart_edit' | t }}"
                data-custom-class="cart-item-edit"
                href="{{ item_url }}"
                class="minicart__item-edit pointer relative inline-flex align-center"
                data-id="{{ item.id }}"
                data-key="{{ item.key }}"
                data-line-index="{{ line }}"
                data-quantity="{{ item.quantity }}"
              >
                <svg width="12" height="12" fill="none" class="dark-grey edit-icon hover-heading-color transition">
                  <use href="#icon-edit" />
                </svg>
                <div class="icon-rotator"></div>
              </minicart-item-edit>
            {% endif %}
          {%- endunless -%}
          <mini-cart-remove-button
            data-product-handle="{{ item.product.id }}"
            class="minicart__item-remove {% if show_message_when_remove %} action-add-wishlist{% endif %}"
            data-index="{{- item.key -}}"
          >
            <a
              href="{{ item.url_to_remove }}"
              class="cart-remove button--tertiary relative underline fs-small hover-heading-color transition"
              arial-label="{{- 'general.cart.remove' | t -}}"
              name="{{- 'general.cart.remove' | t -}}"
            >
              {{- 'general.cart.remove' | t -}}
            </a>
          </mini-cart-remove-button>
        </div>
    {% endif %}
  {% endif %}
  </div>
  {% if show_message_when_remove %}
    <div class="flex-1 relative minicart__wishlist fadeIn" style="display: none;">
      <p class="pr-20">
        {{ 'templates.wishlist.title_remove' | t }}
      </p>
      <minicart-wishlist-action
        data-index="{{- item.key -}}"
        class="mt-10 flex gap-10 relative align-center"
        style="--btn-padding-y: 8px;--btn-padding-x: 2.5rem;"
      >
        <a
          data-product-id="{{ item.product.id }}"
          data-index="{{- item.key -}}"
          class="btn-primary btn-small product-wishlist-js btn-minicart__add-wishlist-js pointer fs-small"
          type="button"
          role="button"
          aria-label="{{ 'templates.wishlist.action_yes' | t }}"
        >
          {{ 'templates.wishlist.action_yes' | t }}
        </a>
        <a
          data-index="{{- item.key -}}"
          class="btn-outline btn-small bg-grey btn-minicart__remove-js pointer text-center fs-small"
          type="button"
          role="button"
          aria-label="{{ 'templates.wishlist.action_no' | t }}"
        >
          {{ 'templates.wishlist.action_no' | t }}
        </a>
        <div class="icon-rotator"></div>
      </minicart-wishlist-action>
      <a href="#" class="cart-close-wishlist button--tertiary absolute top-0 right-0 z-1 grey-color pointer">
        <svg width="14" height="14" fill="none">
          <use href="#icon-trash" />
        </svg>
      </a>
    </div>
  {% endif %}
</div>

{%- comment -%}
  Filtro Botinas (ex.: Masculinas | Femininas | Trabalho).
  Cada label é um link p/ o destino escolhido no editor (coleção, página, URL).
  O botão cujo link aponta p/ a página atual fica marcado como ativo.
  Estilização: provisória (mesmo desenho das pills do Filtro de Gênero).

  Uso: {% render 'boot-filter-block', block: block %}
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign btn_count = 0
  assign current_path = request.path | downcase
-%}
<style>
  .boot-filter {
    --bf-green: var(--btn-primary-bg-color, #085b47);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
  }
  .boot-filter__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #6b6b6b;
    line-height: 1;
  }
  .boot-filter__btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .boot-filter__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 600;
    border: 1.5px solid var(--bf-green);
    border-radius: 50px;
    background: transparent;
    color: var(--bf-green);
    text-decoration: none;
    white-space: nowrap;
  }
  .boot-filter__btn:hover,
  .boot-filter__btn.active {
    background: var(--bf-green);
    color: #fff;
  }
</style>

{%- capture buttons -%}
  {%- for i in (1..3) -%}
    {%- liquid
      assign label_key = 'label_' | append: i
      assign link_key = 'link_' | append: i
      assign label = bs[label_key]
      assign link = bs[link_key]
      if label == blank or link == blank
        continue
      endif
      assign link_path = link | split: '?' | first | downcase
      assign is_active = false
      if link_path == current_path
        assign is_active = true
      endif
      assign btn_count = btn_count | plus: 1
    -%}
    <a
      href="{{ link }}"
      class="boot-filter__btn{% if is_active %} active{% endif %}"
      {% if is_active %}
        aria-current="page"
      {% endif %}
    >
      {{- label | escape -}}
    </a>
  {%- endfor -%}
{%- endcapture -%}

{%- if btn_count > 0 -%}
  <nav class="boot-filter" id="boot-filter-{{ block.id }}" aria-label="{{ bs.eyebrow | default: 'Filtro de botinas' | escape }}" {{ block.shopify_attributes }}>
    {%- if bs.eyebrow != blank -%}
      <span class="boot-filter__label">{{ bs.eyebrow | escape }}</span>
    {%- endif -%}
    <div class="boot-filter__btns">
      {{ buttons }}
    </div>
  </nav>
{%- endif -%}

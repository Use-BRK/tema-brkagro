{%- comment -%}
  Ícone da topbar compacta. Params:
    icon: 'none' | 'truck' | 'bolt'
    icon_url: (opcional) URL de imagem/SVG que sobrepõe o ícone predefinido.
  Os SVGs usam currentColor, então herdam a cor do texto da topbar.
{%- endcomment -%}
{%- liquid
  assign icon = icon | default: 'none'
-%}
{%- if icon_url != blank -%}
  <img class="topbar-compact__icon" src="{{ icon_url }}" alt="" width="18" height="18" loading="lazy">
{%- elsif icon == 'truck' -%}
  <svg class="topbar-compact__icon" width="19" height="19" viewBox="0 0 25 25" fill="none" aria-hidden="true">
    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14.501h1c1.1 0 2-.9 2-2v-10H6c-1.5 0-2.81.83-3.49 2.05"></path>
    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 17.501c0 1.66 1.34 3 3 3h1c0-1.1.9-2 2-2s2 .9 2 2h4c0-1.1.9-2 2-2s2 .9 2 2h1c1.66 0 3-1.34 3-3v-3h-3c-.55 0-1-.45-1-1v-3c0-.55.45-1 1-1h1.29l-1.71-2.99a2.016 2.016 0 0 0-1.74-1.01H15v7c0 1.1-.9 2-2 2h-1"></path>
    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 22.501a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM16 22.501a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM22 12.501v2h-3c-.55 0-1-.45-1-1v-3c0-.55.45-1 1-1h1.29l1.71 3ZM2 8.501h6M2 11.501h4M2 14.501h2"></path>
  </svg>
{%- elsif icon == 'bolt' -%}
  <svg class="topbar-compact__icon" width="15" height="15" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
    <path fill-rule="evenodd" d="m154.8 141.5c-31 77.3-56.1 140.8-55.8 141.1 0.3 0.3 30.4-3.9 67-9.4 36.6-5.5 66.6-9.8 66.7-9.6 0.2 0.2-25 50-55.8 110.7-30.9 60.6-58.8 115.3-62 121.5-3.3 6.1-5.6 11.2-5.2 11.2 0.5 0 35.4-40.8 77.8-90.6 42.4-49.9 108.2-127.4 146.3-172.3 38.1-44.9 69.2-81.9 69.2-82.3 0-0.5-0.8-0.6-1.8-0.3-0.9 0.3-34.6 4.8-74.7 10-40.2 5.2-73.9 9.7-75 10-1.4 0.4-1.8 0.2-1.3-0.7 0.3-0.7 22.2-41.1 48.6-89.8l48-88.5c-21.9-1-52.5-1.3-82-1.4l-53.6-0.1z"></path>
  </svg>
{%- endif -%}

{%- liquid
  assign t = template | split: '.' | first
  assign admin_vi = request.design_mode
  assign salt = shop.permanent_domain | append: "GlzSalt25" | sha256 | slice: 0, 16
  assign encoded_base = shop.email | base64_encode
  assign hmac = shop.email | hmac_sha256: salt
  assign encoded = encoded_base | append: ":" | append: hmac | base64_encode
-%}
<script src="{{ 'tingle.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-components.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'theme.js' | asset_url }}"  defer="defer" type="module"></script>
<script src="{{ 'gift-progress-bar.js' | asset_url }}" defer="defer"></script>
{%- case t -%}
  {%- when 'collection' and collection.handle -%}
    <script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
  {%- when 'product' -%}
    <script src="{{ 'product-form-safety.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'main-product.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'js-cloudimage-360-view.min.js' | asset_url }}" defer="defer"></script>
  {%- when 'search' -%}
    <script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
{%- endcase -%}
<script defer="defer">
  var glozin_app = {
  shop: '{{ shop.permanent_domain }}',
  domain: '{{ shop.domain }}',
  {%- if admin_vi == true -%}
    lic: '{{ settings.purchase_code }}',
    action: '{{ settings.purchase_code_action }}',
    _e: '{{ encoded }}',
    _s: '{{ salt }}',
  {%- endif -%}
  mode: '{%- if admin_vi == true -%}admin{% else %}front{%- endif -%}',
  };
</script>

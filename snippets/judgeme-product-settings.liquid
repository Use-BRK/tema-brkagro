{% doc %}
  Configures the compact product review widget with BRK Agro colors before Judge.me initializes.
{% enddoc %}
<script>
  window.jdgmSettings = Object.assign(window.jdgmSettings || {}, {
    review_widget_header_theme: 'minimal',
    review_widget_button_color: '#085B47',
    review_widget_star_and_histogram_color: '#085B47',
    widget_primary_color: '#085B47',
    review_widget_expanded_media_gallery_enabled: false,
    review_form_theme: 'multi_step',
    review_form_star_color: '#085B47',
    review_form_button_color: '#085B47'
  });
</script>

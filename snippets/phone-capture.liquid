{%- if customer and customer.phone == blank -%}
  <div id="phone-capture-overlay" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);align-items:center;justify-content:center">
    <div style="background:var(--color-background,#fff);border-radius:12px;padding:32px;max-width:400px;width:90%;margin:auto;position:relative;box-shadow:0 8px 30px rgba(0,0,0,0.15)">
      <button type="button" id="phone-capture-dismiss" style="position:absolute;top:12px;right:12px;background:none;border:none;cursor:pointer;padding:4px;color:var(--color-heading,#333)">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M12.207 4.793a1 1 0 0 0-1.414 0L8 7.586 5.207 4.793a1 1 0 1 0-1.414 1.414L6.586 9l-2.793 2.793a1 1 0 1 0 1.414 1.414L8 10.414l2.793 2.793a1 1 0 0 0 1.414-1.414L9.414 9l2.793-2.793a1 1 0 0 0 0-1.414z"/></svg>
      </button>
      <h3 style="margin:0 0 8px;font-size:18px;color:var(--color-heading,#333)">Complete seu cadastro</h3>
      <p style="margin:0 0 20px;font-size:14px;color:var(--color-text,#666)">Precisamos do seu telefone para contato sobre seus pedidos.</p>
      <form id="phone-capture-form">
        <div style="margin-bottom:16px">
          <input
            type="tel"
            id="phone-capture-input"
            placeholder="(00) 00000-0000"
            required
            style="width:100%;padding:12px 14px;border:1px solid #ddd;border-radius:8px;font-size:16px;box-sizing:border-box"
          >
          <p id="phone-capture-error" style="display:none;color:#d0473e;font-size:13px;margin:8px 0 0"></p>
        </div>
        <button type="submit" id="phone-capture-submit" class="btn-primary" style="width:100%;padding:12px;border:none;border-radius:8px;font-size:15px;cursor:pointer">
          Salvar telefone
        </button>
      </form>
    </div>
  </div>
  <script>
    (function() {
      var STORAGE_KEY = 'phone_capture_dismissed';
      var API_URL = 'https://brk-apps-agro.allexadriel.workers.dev/api/customer-phone';
      var CUSTOMER_ID = '{{ customer.id }}';
      var overlay = document.getElementById('phone-capture-overlay');
      var dismiss = document.getElementById('phone-capture-dismiss');
      var form = document.getElementById('phone-capture-form');
      var input = document.getElementById('phone-capture-input');
      var errorEl = document.getElementById('phone-capture-error');
      var submitBtn = document.getElementById('phone-capture-submit');

      if (!overlay) return;
      if (localStorage.getItem(STORAGE_KEY)) return;
      overlay.style.display = 'flex';

      function close() {
        overlay.style.display = 'none';
        localStorage.setItem(STORAGE_KEY, Date.now());
      }

      function formatPhone(value) {
        var digits = value.replace(/\D/g, '').slice(0, 11);
        if (digits.length <= 2) return '(' + digits;
        if (digits.length <= 7) return '(' + digits.slice(0,2) + ') ' + digits.slice(2);
        return '(' + digits.slice(0,2) + ') ' + digits.slice(2,7) + '-' + digits.slice(7);
      }

      input.addEventListener('input', function() {
        var pos = input.selectionStart;
        var before = input.value.length;
        input.value = formatPhone(input.value);
        var after = input.value.length;
        var newPos = pos + (after - before);
        input.setSelectionRange(newPos, newPos);
      });

      dismiss.addEventListener('click', close);
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) close();
      });

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var digits = input.value.replace(/\D/g, '');
        if (digits.length < 10) {
          errorEl.textContent = 'Digite um telefone válido com DDD.';
          errorEl.style.display = 'block';
          return;
        }
        var phone = '+55' + digits;

        errorEl.style.display = 'none';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Salvando...';

        fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ customerId: CUSTOMER_ID, phone: phone })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            submitBtn.textContent = 'Salvo!';
            localStorage.setItem(STORAGE_KEY, 'saved');
            setTimeout(function() { overlay.style.display = 'none'; }, 800);
          } else {
            errorEl.textContent = data.error || 'Erro ao salvar. Tente novamente.';
            errorEl.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Salvar telefone';
          }
        })
        .catch(function() {
          errorEl.textContent = 'Erro de conexão. Tente novamente.';
          errorEl.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Salvar telefone';
        });
      });
    })();
  </script>
{%- endif -%}

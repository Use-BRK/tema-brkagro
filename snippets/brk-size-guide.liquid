{%- comment -%}
  Botão "Descubra o seu tamanho" + popup do guia de medidas.
  Renderizado pelo bloco blocks/_brk-size-guide.liquid.

  Accepts:
  - guide {Block}: bloco _brk-size-guide com o conteúdo editável
{%- endcomment -%}
{%- liquid
  assign st = guide.settings
  assign rows = st.rows | newline_to_br | split: '<br />'
-%}
<product-addons
  data-text-header="{{ st.popup_title | default: 'Guia de tamanhos' | escape }}"
  data-custom-class="size_chart"
  class="brk-sg-trigger product-addons__ask-question pointer transition skeleton-loading"
>
  <svg class="brk-sg-trigger__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3.6 15.9 15.9 3.6a1.5 1.5 0 0 1 2.1 0l2.4 2.4a1.5 1.5 0 0 1 0 2.1L8.1 20.4a1.5 1.5 0 0 1-2.1 0L3.6 18a1.5 1.5 0 0 1 0-2.1Z"/>
    <path d="m7.5 12 2 2M10 9.5l1.4 1.4M12.5 7l2 2M15 4.5l1.4 1.4"/>
  </svg>
  <span class="brk-sg-trigger__label">{{ st.button_label | default: 'Descubra o seu tamanho' }}</span>
  <div class="product-addons__content ask-question__content hidden">
    <div class="brk-sg" style="--brk-sg-blue: {{ st.color_primary | default: '#0f294b' }}; --brk-sg-sand: {{ st.color_highlight | default: '#ede5da' }};">
      {%- if st.heading != blank -%}
        <div class="brk-sg__bar brk-sg__title">{{ st.heading }}</div>
      {%- endif -%}

      <div class="brk-sg__how">
        {%- if st.image != blank -%}
          {{ st.image | image_url: width: 800 | image_tag: class: 'brk-sg__img', loading: 'lazy', widths: '300, 400, 600, 800' }}
        {%- else -%}
          <img
            class="brk-sg__img"
            src="{{ 'brk-guia-medida-cabeca.png' | asset_url }}"
            alt="Fita métrica posicionada ao redor da cabeça, logo acima das orelhas"
            width="400"
            height="425"
            loading="lazy"
          >
        {%- endif -%}
        <ol class="brk-sg__steps">
          {%- assign step_num = 0 -%}
          {%- for step in (1..3) -%}
            {%- assign step_key = 'step_' | append: step -%}
            {%- if st[step_key] != blank -%}
              {%- assign step_num = step_num | plus: 1 -%}
              <li>
                <span class="brk-sg__num">{% if step_num < 10 %}0{% endif %}{{ step_num }}</span>
                <p>{{ st[step_key] }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>

      {%- if st.tip_text != blank -%}
        <div class="brk-sg__bar brk-sg__tip">
          {%- if st.tip_label != blank -%}<span class="brk-sg__tip-label">{{ st.tip_label }}</span>{%- endif -%}
          <p>{{ st.tip_text }}</p>
        </div>
      {%- endif -%}
      {%- if st.note != blank -%}
        <p class="brk-sg__note">{{ st.note }}</p>
      {%- endif -%}

      {%- if st.rows != blank -%}
        <table class="brk-sg__table">
          <thead>
            <tr>
              <th>
                <span class="brk-sg__th-main">
                  {{ st.col_1 }}
                  {%- if st.show_flags %}
                    <svg class="brk-sg__flag" viewBox="0 0 19 10" aria-hidden="true">
                      <rect width="19" height="10" fill="#fff"/>
                      <path d="M0 0h19v1H0zm0 2h19v1H0zm0 2h19v1H0zm0 2h19v1H0zm0 2h19v1H0z" fill="#b22234"/>
                      <rect width="8" height="5.4" fill="#3c3b6e"/>
                    </svg>
                    <svg class="brk-sg__flag" viewBox="0 0 20 14" aria-hidden="true">
                      <rect width="20" height="14" fill="#009c3b"/>
                      <path d="M10 1.6 18.4 7 10 12.4 1.6 7Z" fill="#ffdf00"/>
                      <circle cx="10" cy="7" r="3.2" fill="#002776"/>
                    </svg>
                  {%- endif -%}
                </span>
                {%- if st.col_1_sub != blank -%}
                  <span class="brk-sg__th-sub">{{ st.col_1_sub }}</span>
                {%- endif -%}
              </th>
              <th>{{ st.col_2 }}</th>
              <th>{{ st.col_3 }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for row in rows -%}
              {%- assign row_clean = row | strip -%}
              {%- if row_clean == blank -%}{%- continue -%}{%- endif -%}
              {%- assign cols = row_clean | split: '|' -%}
              {%- assign size_label = cols[0] | strip -%}
              {%- assign size_main = size_label | split: ' ' | first -%}
              {%- assign size_rest = size_label | remove_first: size_main -%}
              <tr>
                <td><b>{{ size_main }}</b>{{ size_rest }}</td>
                <td>{{ cols[1] | strip }}</td>
                <td>{{ cols[2] | strip }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- endif -%}
    </div>
  </div>
</product-addons>

<style>
  /* sobrescreve o estilo "pill" global do size_chart (custom.css) */
  product-addons.brk-sg-trigger[data-custom-class="size_chart"] {
    display: inline-flex; align-items: center; gap: .6rem;
    padding: 0; border: 0; border-radius: 0; background: transparent;
    color: inherit; font-size: 1.5rem; font-weight: 400; white-space: nowrap;
    text-decoration: underline; text-underline-offset: .3rem;
  }
  product-addons.brk-sg-trigger[data-custom-class="size_chart"]::before { content: none; display: none; }
  product-addons.brk-sg-trigger[data-custom-class="size_chart"]:hover { background: transparent; opacity: .8; }
  .brk-sg-trigger__icon { width: 2rem; height: 2rem; flex: 0 0 auto; }

  .brk-sg {
    --brk-sg-row: #f1f2f4;
    --brk-sg-row-alt: #f7f8f9;
    color: #1f2320; font-family: var(--body-font);
    display: grid; gap: 1.8rem;
  }
  .brk-sg__bar { background: var(--brk-sg-blue); color: #fff; border-radius: 8px; }
  .brk-sg__title {
    padding: 1.4rem 1.6rem; text-align: center; text-transform: uppercase;
    font-family: var(--heading-font); font-weight: 700; font-size: 2.2rem; letter-spacing: .02em;
  }
  .brk-sg__how { display: grid; grid-template-columns: 42% 1fr; gap: 1.6rem; align-items: center; }
  .brk-sg__img { width: 100%; height: auto; display: block; }
  .brk-sg__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.2rem; }
  .brk-sg__steps li { display: flex; align-items: center; gap: 1rem; }
  .brk-sg__num {
    flex: 0 0 auto; width: 4.4rem; height: 4.4rem; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brk-sg-blue); color: #fff; font-weight: 700; font-size: 1.7rem;
  }
  .brk-sg__steps p {
    flex: 1; margin: 0; padding: 1rem 1.2rem; border-radius: 6px;
    background: var(--brk-sg-row); text-align: center; font-size: 1.3rem; line-height: 1.4;
  }
  .brk-sg__tip { display: flex; align-items: center; gap: 1.6rem; padding: 1.4rem 1.8rem; }
  .brk-sg__tip-label {
    color: #fff; font-family: var(--heading-font); font-size: 2.6rem; text-transform: uppercase;
    padding-right: 1.6rem; border-right: 1px solid rgba(255, 255, 255, .6); line-height: 1.1;
  }
  .brk-sg__tip p { margin: 0; text-align: center; font-size: 1.4rem; line-height: 1.4; color: #fff; }
  .brk-sg__tip p strong, .brk-sg__tip p b { color: var(--brk-sg-sand); }
  .brk-sg__note { margin: -.6rem 0 0; font-size: 1.2rem; text-align: center; color: #4b4f55; }

  .brk-sg__table {
    width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed;
    border-radius: 8px; overflow: hidden; font-size: 1.5rem; text-align: center;
  }
  .brk-sg__table th {
    background: var(--brk-sg-blue); color: #fff; padding: 1.2rem .8rem;
    font-weight: 600; font-size: 1.4rem; line-height: 1.25; vertical-align: middle;
  }
  .brk-sg__table th + th, .brk-sg__table td + td { border-left: 1px solid rgba(15, 41, 75, .12); }
  .brk-sg__table th + th { border-left-color: rgba(255, 255, 255, .25); }
  .brk-sg__th-main { display: inline-flex; align-items: center; gap: .4rem; }
  .brk-sg__th-sub { display: block; font-weight: 400; font-size: 1.2rem; opacity: .85; }
  .brk-sg__flag { width: 1.9rem; height: 1.3rem; border-radius: 2px; }
  .brk-sg__table td { padding: 1.1rem .8rem; background: var(--brk-sg-row); color: #1f2320; }
  .brk-sg__table tbody tr:nth-child(even) td { background: var(--brk-sg-row-alt); }
  .brk-sg__table b { color: var(--brk-sg-blue); }

  @media (max-width: 575.98px) {
    .brk-sg { gap: 1.4rem; }
    .brk-sg__title { font-size: 1.8rem; }
    .brk-sg__how { grid-template-columns: 1fr; }
    .brk-sg__img { max-width: 22rem; margin-inline: auto; }
    .brk-sg__tip { flex-direction: column; gap: .8rem; }
    .brk-sg__tip-label { border-right: 0; padding-right: 0; font-size: 2.2rem; }
    .brk-sg__table { font-size: 1.3rem; }
    .brk-sg__table th { font-size: 1.2rem; padding: 1rem .4rem; }
  }
</style>

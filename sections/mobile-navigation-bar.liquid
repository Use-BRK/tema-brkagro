{% liquid
  assign section_st = section.settings
  assign show_account = section_st.show_account
  assign account_open_as = settings.open_as | default: 'show_popup_login'
  assign show_account_popup = false
  assign account_menu = settings.customer_account_menu | default: 'customer-account-main-menu'
  if show_account
    if account_open_as == 'show_popup_login'
      if shop.customer_accounts_enabled
        assign show_account_popup = true
      endif
    endif
  endif
%}
{% capture account_icon %}
  <svg width="20" height="20" fill="none">
    <g fill="currentColor"><path d="M18.887 17.699a10.285 10.285 0 0 0-3.768-3.704 10.353 10.353 0 0 0-10.24 0 10.285 10.285 0 0 0-3.768 3.704.87.87 0 0 0 .075.962c.073.09.164.165.268.217a.881.881 0 0 0 .44.114.829.829 0 0 0 .754-.42 8.515 8.515 0 0 1 3.12-3.068 8.572 8.572 0 0 1 8.48 0 8.514 8.514 0 0 1 3.12 3.068.878.878 0 0 0 1.195.315.808.808 0 0 0 .404-.516.869.869 0 0 0-.08-.672ZM10 11.803c1.416 0 2.775-.56 3.784-1.56 1.01-1.001 1.59-2.362 1.617-3.79a5.476 5.476 0 0 0-1.582-3.854 5.375 5.375 0 0 0-3.818-1.596 5.375 5.375 0 0 0-3.819 1.596 5.476 5.476 0 0 0-1.581 3.854 5.474 5.474 0 0 0 1.616 3.79A5.374 5.374 0 0 0 10 11.802Zm-3.6-5.35c0-.964.38-1.888 1.055-2.57a3.583 3.583 0 0 1 2.546-1.063c.955 0 1.87.382 2.545 1.064a3.65 3.65 0 0 1 1.055 2.569 3.65 3.65 0 0 1-1.055 2.569 3.583 3.583 0 0 1-2.545 1.064c-.955 0-1.87-.383-2.546-1.064a3.65 3.65 0 0 1-1.054-2.57Z"/></g>
  </svg>
{% endcapture %}
{% if show_account_popup %}
  {{ 'header-account-popup.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'header-account-popup.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- capture style -%}
--number: {{ section.blocks.size }};
{%- endcapture -%}
{% if section.blocks.size > 0 %}
  <mobile-navigation-bar
    class="mobile-navigation-bar transition flex invisible algin-center hidden-md fixed bottom-0 inset-x-0 z-10 bg-white shadow px-15 py-13 color-default show"
    style="{{ style | strip | strip_newlines }}"
  >
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'homepage' %}
          <a
            href="{{ routes.root_url }}"
            id="homepage-icon-bubble"
            class="no-underline lh-normal inline-flex content-center flex-column text-center heading-color px-5{% if request.path == "/" %} active{% endif %}"
            aria-label="{{ 'mobile_navbar.homepage' | t }}"
          >
            <svg width="20" height="20" fill="none">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 15.001v-2.5M8.392 2.353 2.617 6.977c-.65.517-1.066 1.609-.924 2.425L2.8 16.035c.2 1.183 1.333 2.141 2.533 2.141h9.332c1.192 0 2.333-.966 2.533-2.141l1.108-6.633c.134-.816-.283-1.908-.924-2.425l-5.775-4.616c-.891-.716-2.333-.716-3.216-.008Z"/>
            </svg>
            <span class="block fs-small heading-style">
              {{- 'mobile_navbar.homepage' | t -}}
            </span>
          </a>
        {% when 'whatsapp-contact' %}
          <a
            id="whatsapp-contact"
            href="https://wa.me/553432194697?text=Oi,%20vim%20da%20loja%20BRK%20AGRO!"
            class="no-underline lh-normal inline-flex content-center flex-column text-center heading-color px-5"
            aria-label="WhatsApp"
          >
            <svg width="25" height="25" fill="currentColor" viewBox="0 0 16 16">
              <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
            </svg>
            <span class="block fs-small heading-style">
              WhatsApp
            </span>
          </a>
        {% when 'shop' %}
          <a
            href="{{ collections.all.url }}"
            class="no-underline lh-normal inline-flex content-center flex-column text-center heading-color px-5{% if request.path == "/collections/all" %} active{% endif %}"
            aria-label="{{ 'mobile_navbar.shop' | t }}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none">
              <g stroke="CURRENTCOLOR" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M2.508 9.352v3.742c0 3.741 1.5 5.241 5.242 5.241h4.492c3.741 0 5.241-1.5 5.241-5.241V9.352"/><path d="M10 10.002c1.525 0 2.65-1.242 2.5-2.767l-.55-5.566H8.058L7.5 7.235c-.15 1.525.975 2.767 2.5 2.767Z"/><path d="M15.258 10.002c1.684 0 2.917-1.367 2.75-3.042l-.233-2.291c-.3-2.167-1.133-3-3.317-3h-2.541L12.5 7.51c.142 1.375 1.383 2.492 2.758 2.492ZM4.7 10.002c1.375 0 2.617-1.117 2.75-2.492l.183-1.841.4-4H5.492c-2.184 0-3.017.833-3.317 3L1.95 6.96c-.167 1.675 1.067 3.042 2.75 3.042ZM10 14.169c-1.392 0-2.083.691-2.083 2.083v2.083h4.166v-2.083c0-1.392-.691-2.083-2.083-2.083Z"/></g>
            </svg>
            <span class="block fs-small heading-style">{{ 'mobile_navbar.shop' | t }}</span>
          </a>
        {% when 'account' %}
          {% if show_account %}
            {% if show_account_popup %}
              <div class="header-account-popup mobile-navigation-account mobile_icon inline-flex flex-column justify-center heading-color gap-3{% if request.path == "/account/login" or request.path == "/account" %} active{% endif %}">
                <shopify-account menu="{{ account_menu }}" data-account-popup-layout="mobile-sheet">
                  <span
                    slot="signed-out-avatar"
                    class="header-account-popup__avatar no-underline lh-normal inline-flex content-center flex-column text-center heading-color px-5"
                    aria-hidden="true"
                  >
                    {{ account_icon }}
                    <span class="block fs-small heading-style">{{ 'customer.account_fallback' | t }}</span>
                  </span>
                  <span
                    slot="signed-in-avatar"
                    class="header-account-popup__avatar no-underline lh-normal inline-flex content-center flex-column text-center heading-color px-5"
                    aria-hidden="true"
                  >
                    {{ account_icon }}
                    <span class="block fs-small heading-style">{{ 'customer.account_fallback' | t }}</span>
                  </span>
                </shopify-account>
              </div>
            {% else %}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="no-underline lh-normal inline-flex content-center flex-column text-center heading-color px-5 gap-3{% if request.path == "/account/login" or request.path == "/account" %} active{% endif %}"
                aria-label="{{ 'customer.account_fallback' | t }}"
              >
                {{ account_icon }}
                <span class="block fs-small heading-style">
                  {{ 'customer.account_fallback' | t }}
                </span>
              </a>
            {% endif %}
          {% endif %}
        {% when 'cart' %}
          <a
            id="cart-icon-bubble-mobile"
            href="#"
            class="minicart__action no-underline lh-normal inline-flex content-center flex-column text-center heading-color{% if request.path == "/cart" %} active{% endif %}"
            aria-label="{{ 'mobile_navbar.cart' | t }}"
          >
            <span class="relative inline-flex">
              <svg width="20" height="20" fill="none">
                <path fill="currentColor" d="m16.102 4.278-1.2-1.649H6.098L4.898 4.278h11.204Zm2.23.307v.019h.018c.038.077.069.153.094.23a.56.56 0 0 1 .056.25v11.462c0 .333-.069.652-.206.959-.125.294-.294.55-.506.767-.212.23-.468.409-.768.536a2.233 2.233 0 0 1-.918.192H4.898c-.324 0-.637-.07-.937-.21a2.402 2.402 0 0 1-.749-.518 2.312 2.312 0 0 1-.525-.767 2.518 2.518 0 0 1-.187-.959V5.083a1.112 1.112 0 0 1 .075-.345l.038-.077a.3.3 0 0 0 .056-.076l2.398-3.26a.706.706 0 0 1 .28-.23A.71.71 0 0 1 5.705 1h9.592a.71.71 0 0 1 .356.096.706.706 0 0 1 .281.23l2.398 3.259ZM4.111 5.907v10.64c0 .102.018.204.056.306a.747.747 0 0 0 .43.44c.1.04.2.058.3.058h11.204a.74.74 0 0 0 .3-.057.748.748 0 0 0 .43-.44.887.887 0 0 0 .057-.308V5.907H4.11Zm8.786 2.454a.79.79 0 0 1 .225-.575.784.784 0 0 1 .58-.25c.213 0 .394.084.544.25a.758.758 0 0 1 .244.575c0 .562-.106 1.093-.319 1.591-.2.498-.48.933-.843 1.304-.362.37-.787.664-1.274.881a3.977 3.977 0 0 1-1.555.307c-.55 0-1.068-.102-1.555-.307A4.096 4.096 0 0 1 6.81 9.952c-.2-.498-.3-1.029-.3-1.591a.79.79 0 0 1 .225-.575.764.764 0 0 1 .562-.25c.225 0 .413.084.562.25a.758.758 0 0 1 .244.575c0 .345.062.665.187.958.125.294.3.55.525.767a2.259 2.259 0 0 0 1.686.729 2.258 2.258 0 0 0 1.686-.728c.225-.218.4-.474.525-.768.125-.293.187-.613.187-.958Z"/>
              </svg>
              {%- if cart != empty -%}
                <span class="absolute lh-1 cart-count h-count inline-flex align-center justify-content-center rounded-50 overflow-hidden fs-10">
                  {%- if cart.item_count < 100 -%}
                    {{ cart.item_count }}
                  {%- else -%}
                    ~
                  {% endif %}
                  <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
                </span>
              {%- else -%}
                <span class="absolute lh-1 cart-count h-count inline-flex align-center justify-content-center rounded-50 overflow-hidden fs-10">
                  <span aria-hidden="true">0</span>
                </span>
              {% endif %}
            </span>
            <span class="block fs-small heading-style">{{ 'mobile_navbar.cart' | t }}</span>
          </a>
        {% when 'wishlist' %}
          <a
            id="wishlist-icon-bubble-mobile"
            href="/pages/wishlist"
            class="wishlist-icon-bubble no-underline lh-normal inline-flex content-center flex-column text-center heading-color"
            aria-label="{{ 'mobile_navbar.wishlist' | t }}"
          >
            <span class="relative inline-flex">
              <svg width="22" height="20" fill="none">
                <path fill="currentColor" d="M19.389 2.646C18.35 1.589 16.977 1 15.549 1s-2.801.589-3.84 1.646L11 3.375l-.71-.73C9.256 1.583 7.878.993 6.448 1 5.019.993 3.644 1.583 2.61 2.646a5.496 5.496 0 0 0-1.19 1.82A5.847 5.847 0 0 0 1 6.647c0 .75.143 1.493.42 2.182a5.497 5.497 0 0 0 1.191 1.82l7.828 8.11c.077.072.163.132.256.178a.77.77 0 0 0 .61 0c.093-.046.18-.106.256-.178l7.828-8.11a5.497 5.497 0 0 0 1.19-1.82c.278-.689.421-1.431.421-2.182 0-.75-.143-1.493-.42-2.18a5.497 5.497 0 0 0-1.191-1.821Zm0 3.984a4.149 4.149 0 0 1-.285 1.531c-.19.485-.469.923-.82 1.287L11 17.008l-7.275-7.56a3.883 3.883 0 0 1-.836-1.283 4.129 4.129 0 0 1 0-3.071c.194-.485.479-.922.836-1.283.732-.755 1.709-1.173 2.722-1.165 1.018-.009 2 .409 2.738 1.165l1.254 1.307c.077.072.163.132.256.178a.77.77 0 0 0 .61 0c.093-.046.18-.106.256-.178l1.262-1.307c.732-.755 1.709-1.173 2.722-1.165 1.018-.009 2 .409 2.738 1.165.355.363.637.8.83 1.285.193.484.293 1.006.292 1.534h-.016Z"/>
              </svg>
              <span class="absolute lh-1 wishlist-count h-count inline-flex align-center justify-content-center rounded-50 overflow-hidden fs-10">
                0
              </span>
            </span>
            <span class="block fs-small heading-style">
              {{- 'mobile_navbar.wishlist' | t -}}
            </span>
          </a>
        {% when 'currency' %}
          <div class="lang__currency-on-nav mobile-navigation__currency lh-normal inline-flex content-center flex-column text-center heading-color">
            {%- render 'country-switcher' | type: 'mobile-navigation' -%}
          </div>
        {% when 'language' %}
          <div class="lang__currency-on-nav mobile-navigation__currency lh-normal inline-flex content-center flex-column text-center heading-color">
            {% render 'language-switcher' | type: 'mobile-navigation' %}
          </div>
        {% when 'navbar-collection' %}
          {%- liquid
            assign target_collection = block.settings.collection
            assign title = block.settings.title | default: target_collection.title | default: 'Coleção'
            assign custom_svg = block.settings.custom_svg
            assign svg_width = block.settings.svg_width | default: 25
            assign svg_height = block.settings.svg_height | default: 25
          -%}
          <a
            href="{{ target_collection.url | default: '#' }}"
            class="no-underline lh-normal inline-flex content-center flex-column text-center heading-color px-5{% if target_collection != blank and request.path contains target_collection.url %} active{% endif %}"
            aria-label="{{ title }}"
            {{ block.shopify_attributes }}
          >
            {% if custom_svg != blank %}
              <div
                class="inline-flex content-center justify-content-center"
                style="width: {{ svg_width }}px; height: {{ svg_height }}px; line-height: 0;"
              >
                {{ custom_svg | replace: '<svg', '<svg width="100%" height="100%"' | replace: '<img', '<img style="width:100%;height:100%;object-fit:contain;"' }}
              </div>
            {% else %}
              <svg version="1.2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="25" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="m92 51.92c-48.13 7-88.14 13.14-88.92 13.65-1.13.74-1.28 2.62-.72 9.43.39 4.67 2.27 30.1 4.19 56.5 1.91 26.4 3.81 48.31 4.22 48.69.4.38 21.43-.64 46.73-2.26 32.31-2.08 46.3-2.64 47-1.89.67.7-.4 50-3.2 148.26-2.31 80.96-3.99 147.54-3.75 147.95.25.41 71.33.75 157.95.75 86.63 0 157.69-.34 157.93-.75.23-.41-1.45-66.99-3.75-147.95-2.79-98.25-3.85-147.56-3.18-148.26.7-.74 13.09-.32 41.5 1.42 22.27 1.36 42.98 2.72 46 3.01 3.02.29 6.05.19 6.73-.22.86-.53 2.27-15.07 4.72-48.75 1.92-26.4 3.8-51.83 4.19-56.5.56-6.81.41-8.68-.72-9.42-.78-.51-41.47-6.69-90.42-13.73-48.95-7.04-89.9-12.83-91-12.86-1.4-.05-3.2 1.83-5.98 6.22-2.19 3.46-6.92 9.38-10.5 13.15-3.59 3.78-9.67 8.97-13.52 11.55-3.85 2.58-10.82 6.07-15.5 7.76-4.68 1.7-12.55 3.64-17.5 4.32-5.17.71-11.77.95-15.5.57-3.57-.37-9.87-1.58-14-2.69-4.12-1.11-10.87-3.78-15-5.93-4.12-2.15-10.36-6.28-13.87-9.18-3.5-2.89-8.74-8.41-11.64-12.26-2.9-3.85-6-8.46-6.88-10.25-1.34-2.71-2.15-3.23-4.86-3.15-1.79.05-42.62 5.82-90.75 12.82z"/>
              </svg>
            {% endif %}
            <span class="block fs-small heading-style">
              {{- title -}}
            </span>
          </a>
      {% endcase %}
    {% endfor %}
  </mobile-navigation-bar>
{% endif %}
{% schema %}
{
  "name": "t:sections.mobile-navigation-bar.name",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.mobile-navigation-bar.info"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:sections.mobile-navigation-bar.settings.show_account",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "homepage",
      "name": "t:sections.mobile-navigation-bar.blocks.homepage",
      "limit": 1,
      "settings": []
    },
    {
      "type": "whatsapp-contact",
      "name": "WhatsApp",
      "limit": 1,
      "settings": []
    },
    {
      "type": "shop",
      "name": "t:sections.mobile-navigation-bar.blocks.shop",
      "limit": 1,
      "settings": []
    },
    {
      "type": "account",
      "name": "t:sections.mobile-navigation-bar.blocks.account",
      "limit": 1,
      "settings": []
    },
    {
      "type": "cart",
      "name": "t:sections.mobile-navigation-bar.blocks.cart",
      "limit": 1,
      "settings": []
    },
    {
      "type": "wishlist",
      "name": "t:sections.mobile-navigation-bar.blocks.wishlist",
      "limit": 1,
      "settings": []
    },
    {
      "type": "currency",
      "name": "t:sections.mobile-navigation-bar.blocks.currency",
      "limit": 1,
      "settings": []
    },
    {
      "type": "language",
      "name": "t:sections.mobile-navigation-bar.blocks.language",
      "limit": 1,
      "settings": []
    },
    {
      "type": "navbar-collection",
      "name": "Navbar Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Coleção"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título personalizado",
          "info": "Deixe em branco para usar o título da coleção"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "SVG ou imagem customizada",
          "info": "Cole o código SVG ou uma tag img aqui."
        },
        {
          "type": "range",
          "id": "svg_width",
          "min": 10,
          "max": 50,
          "step": 1,
          "unit": "px",
          "label": "Largura do ícone",
          "default": 25
        },
        {
          "type": "range",
          "id": "svg_height",
          "min": 10,
          "max": 50,
          "step": 1,
          "unit": "px",
          "label": "Altura do ícone",
          "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.mobile-navigation-bar.name",
      "category": "t:categories.layout",
      "blocks": [
        { "type": "homepage" },
        { "type": "whatsapp-contact" },
        { "type": "shop" },
        { "type": "account" },
        { "type": "wishlist" },
        { "type": "cart" },
        { "type": "navbar-collection" }
      ]
    }
  ]
}
{% endschema %}

{%- liquid
  assign section_st = section.settings
  assign theme_st = settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
-%}
{%- if section.blocks.size > 0 -%}
  {%- style -%}
    #topbar a {
      text-decoration-line: none;
    }
    #topbar .swiper-slide {
      display: flex;
    }
    #topbar
      .swiper:not([class*='initialized'])[data-direction='vertical']
      .swiper-wrapper
      .swiper-slide:not(:first-child) {
      opacity: 0;
    }
    #topbar .text-slide {
      width: 90%;
      flex: 0 0 auto;
      margin: 0 auto;
    }
    .topbar-item .list-social__item a {
      width: 3rem;
      height: 3rem;
    }
    @media (min-width: 1024px) {
      #topbar slide-section {
        padding-left: 4rem;
      }
      #topbar .text-slide {
        width: 50%;
        flex: 0 0 auto;
        max-width: 40rem;
        margin: unset;
      }
    }
    @media (max-width: 1024px) {
      #topbar .swiper-slide {
        justify-content: center;
      }
    }
    #topbar .px-15 {
      display: inline;
      white-space: nowrap;
    }
    .topbar-copy-btn {
      display: inline;
      background: rgb(8, 91, 71);
      border: 1px solid rgb(8, 91, 71);
      color: #fff;
      font-size: 0.80em;
      font-weight: 700;
      letter-spacing: 0.5px;
      padding: 2px 6px;
      margin-left: 6px;
      border-radius: 6px;
      cursor: pointer;
      line-height: 1;
      vertical-align: middle;
      transition: opacity 0.3s, transform 0.3s;
      white-space: nowrap;
    }
    /* .topbar-copy-btn:hover {
      background: rgba(255,255,255,0.35);
      border-color: rgba(255,255,255,0.6);
    } */
    .topbar-copy-btn.is-copied {
      display: none;
    }
    .topbar-copied-msg {
      display: inline;
      margin-left: 6px;
      font-size: 0.75em;
      font-weight: 700;
      letter-spacing: 0.5px;
      vertical-align: middle;
      opacity: 0;
      transition: opacity 0.3s;
      white-space: nowrap;
    }
    .topbar-copied-msg.is-visible {
      opacity: 1;
    }
    .topbar-copied-msg svg {
      width: 10px;
      height: 10px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      vertical-align: middle;
    }
    /* ---- Topbar compacta: 2 itens (ícone + texto) lado a lado ---- */
    #topbar .topbar-compact {
      width: 100%;
    }
    #topbar .topbar-compact__grid {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* Duas metades: cada item centralizado na sua metade (separação garantida). */
    #topbar .topbar-compact__cell {
      flex: 1 1 0;
      min-width: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 10px;
      color: inherit;
      text-decoration: none;
      text-align: center;
      line-height: 1.2;
      white-space: nowrap;
    }
    /* Linha única; se o texto for longo demais, corta com "…" (não sobrepõe). */
    #topbar .topbar-compact__cell > span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #topbar .topbar-compact__icon {
      flex-shrink: 0;
      width: 16px;
      height: 16px;
      display: block;
    }
    @media (min-width: 1025px) {
      #topbar .topbar-compact__grid {
        justify-content: center;
        gap: 10px;
      }
      #topbar .topbar-compact__cell {
        flex: 0 0 auto;
        padding: 0 24px;
        white-space: nowrap;
        font-size: inherit;
      }
      #topbar .topbar-compact__icon {
        width: 18px;
        height: 18px;
      }
    }
    /* ---- Frete grátis + contagem regressiva ---- */
    topbar-shipping-timer[hidden] {
      display: none !important;
    }
    #topbar .topbar-shipping {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1px;
      flex: 1 1 auto;
      min-width: 0;
      text-align: center;
      line-height: 1.2;
      color: var(--topbar-shipping-text, inherit);
    }
    #topbar .topbar-shipping__message {
      white-space: normal;
    }
    #topbar .topbar-shipping__timer-row {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 6px;
    }
    #topbar .topbar-shipping__label {
      font-weight: var(--body-weight);
      opacity: 0.9;
    }
    #topbar .topbar-shipping__countdown {
      display: inline-flex;
      align-items: center;
      font-weight: var(--heading-weight, 700);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0;
      white-space: nowrap;
      color: var(--topbar-shipping-accent, inherit);
      font-size: var(--topbar-shipping-timer-size, 1.4em);
      line-height: 1;
    }
    #topbar .topbar-shipping__seg {
      min-width: 2ch;
      text-align: center;
    }
    #topbar .topbar-shipping__seg:not(:last-child)::after {
      content: ':';
      padding: 0 3px;
      font-weight: var(--body-weight);
      opacity: 0.7;
    }
    #topbar .topbar-shipping__expired {
      font-weight: var(--heading-weight, 700);
    }
  {%- endstyle -%}
  {%- capture style -%}
    --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--swiper-navigation-color: var(--color-text);
  {%- endcapture -%}
  {%- liquid
    assign hidden_block = true
    for block in section.blocks
      assign block_st = block.settings
      if block_st.hidden_on_mobile == false
        assign hidden_block = false
        break
      endif
    endfor
  -%}
  <div
    id="topbar"
    class="topbar gradient{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} section remove_spacing color-{{ color_scheme }}{% if hidden_block == true %} hidden block-1025{% endif %}{% if section_st.show_separator_line %} border-bottom{% endif %}{% if section_st.uppercase %} uppercase{% endif %}{% if section_st.show_mobile == blank %} hidden block-1025{% endif %}"
    style="{{ style | strip | strip_newlines }}"
  >
    <div class="{{ section_width }}">
      <div
        class="flex flex-wrap flex-md-nowrap gap justify-center justify-between-1025 align-center topbar__section-inner gap-10 gap-lg-25 fs-custom {{ section_st.font_weight }}"
        style="--font-size: {{ section_st.font_size }};"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_st = block.settings
          -%}
          {%- case block.type -%}
            {%- when 'store_information' -%}
              {% if theme_st.store_email != blank or theme_st.store_phone != blank %}
                <div class="topbar-item{% if block_st.hidden_on_mobile %} hidden flex-1025{% else %} flex{% endif %} gap-10">
                  {%- if block_st.show_phone and theme_st.store_phone != blank -%}
                    <a
                      class="no-underline"
                      href="tel:{{ theme_st.store_phone }}"
                      arial-label="{{ theme_st.store_phone }}"
                    >
                      <span>{{ theme_st.store_phone }}</span>
                    </a>
                  {% endif %}
                  {%- if block_st.show_email and theme_st.store_email != blank -%}
                    <a
                      class="no-underline"
                      href="mailto:{{ theme_st.store_email }}"
                      arial-label="{{ theme_st.store_email }}"
                    >
                      <span>{{ theme_st.store_email }}</span>
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            {%- when 'socials' -%}
              {%- if settings.facebook != blank
                or settings.instagram != blank
                or settings.twitter != blank
                or settings.tiktok != blank
                or settings.youtube != blank
                or settings.pinterest != blank
                or settings.vimeo != blank
                or settings.linkedin != blank
                or settings.whatsapp != blank
                or settings.tumblr != blank
                or settings.snapchat != blank
              -%}
                <div class="topbar-item{% if block_st.hidden_on_mobile %} hidden block-1025{% endif %}">
                  {%- render 'social-icons' -%}
                </div>
              {% endif %}
            {%- when 'text' -%}
              <div class="topbar-item{% if block_st.hidden_on_mobile %} hidden block-1025{% endif %}">
                {%- if block_st.text != blank -%}
                  <div class="topbar-message">{{- block_st.text -}}</div>
                {% endif %}
              </div>
            {%- when 'text_slider' -%}
              {%- if block_st.compact_mode -%}
                <div class="topbar-item w-full topbar-compact{% if block_st.hidden_on_mobile %} hidden block-1025{% endif %}">
                  <div class="topbar-compact__grid">
                    {%- for i in (1..2) -%}
                      {%- liquid
                        assign k_text = 'compact_text_' | append: i
                        assign k_icon = 'compact_icon_' | append: i
                        assign k_iurl = 'compact_icon_url_' | append: i
                        assign k_link = 'compact_link_' | append: i
                        assign c_text = block_st[k_text]
                        assign c_link = block_st[k_link]
                      -%}
                      {%- if c_text != blank -%}
                        {%- if c_link != blank -%}
                          <a class="topbar-compact__cell no-underline" href="{{ c_link }}">
                        {%- else -%}
                          <div class="topbar-compact__cell">
                        {%- endif -%}
                          {%- render 'topbar-compact-icon', icon: block_st[k_icon], icon_url: block_st[k_iurl] -%}
                          <span>{{ c_text }}</span>
                        {%- if c_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
              <div class="topbar-item w-full text-slide{% if block_st.hidden_on_mobile %} hidden block-1025{% endif %}">
                <slide-section
                  class="swiper bls__swiper text-center text-md-start gap-0 lazy-loading-swiper-before"
                  data-section-id="{{ section.id }}"
                  data-loop="true"
                  data-autoplay="true"
                  data-autoplaySpeed="{{ section_st.change_every }}"
                  data-loop="true"
                  data-mobile="1"
                  data-tablet="1"
                  data-desktop="1"
                  data-direction="vertical"
                  data-spacing="0"
                  style="--color-dark: transparent;--swiper-navigation-color: currentColor; --col-gap: 0;--swiper-navigation-sides-offset: 1rem;"
                >
                  <div class="swiper-action gradient show-arrow static absolute-lg align-center left-0 inset-y-0 z-3 flex gap-20 pe-1025-25 pe-0">
                    <div
                      class="swiper-arrow swiper-button-prev original-style visible absolute left-10 static-lg-impo transform-md-none transition"
                      style="--swiper-navigation-sides-offset: 1rem;--swiper-width: 0.5rem;"
                    >
                      <svg width="6" height="11" fill="none">
                        <use href="#icon-back" />
                      </svg>
                    </div>
                    <div
                      class="swiper-arrow swiper-button-next original-style visible absolute right-10 static-lg-impo transform-md-none transition"
                      style="--swiper-navigation-sides-offset: 1rem;--swiper-width: 0.5rem;"
                    >
                      <svg width="6" height="11" fill="none">
                        <use href="#icon-next" />
                      </svg>
                    </div>
                  </div>
                  <div class="swiper-wrapper">
                    {%- if block_st.text1 != blank -%}
                      <div class="swiper-slide flex align-center text-center text-lg-start lh-normal">
                        <div class="px-15">
                          {{- block_st.text1 -}}
                          {%- if block_st.coupon1_enabled and block_st.coupon1 != blank -%}
                            <button class="topbar-copy-btn" type="button" data-coupon="{{ block_st.coupon1 | escape }}" aria-label="Copiar cupom {{ block_st.coupon1 | escape }}">COPIAR</button>
                          {%- endif -%}
                        </div>
                      </div>
                    {% endif %}
                    {%- if block_st.text2 != blank -%}
                      <div class="swiper-slide flex align-center text-center text-lg-start lh-normal">
                        <div class="px-15">
                          {{- block_st.text2 -}}
                          {%- if block_st.coupon2_enabled and block_st.coupon2 != blank -%}
                            <button class="topbar-copy-btn" type="button" data-coupon="{{ block_st.coupon2 | escape }}" aria-label="Copiar cupom {{ block_st.coupon2 | escape }}">COPIAR</button>
                          {%- endif -%}
                        </div>
                      </div>
                    {% endif %}
                    {%- if block_st.text3 != blank -%}
                      <div class="swiper-slide flex align-center text-center text-lg-start lh-normal">
                        <div class="px-15">
                          {{- block_st.text3 -}}
                          {%- if block_st.coupon3_enabled and block_st.coupon3 != blank -%}
                            <button class="topbar-copy-btn" type="button" data-coupon="{{ block_st.coupon3 | escape }}" aria-label="Copiar cupom {{ block_st.coupon3 | escape }}">COPIAR</button>
                          {%- endif -%}
                        </div>
                      </div>
                    {% endif %}
                  </div>
                </slide-section>
              </div>
              {%- endif -%}
            {%- when 'shipping_countdown' -%}
              {%- liquid
                # Deadline fixado no fuso da loja para todos os visitantes verem o mesmo tempo
                assign tz = 'now' | date: '%z'
                assign tz_h = tz | slice: 0, 3
                assign tz_m = tz | slice: 3, 2
                assign tz_colon = tz_h | append: ':' | append: tz_m
                assign s_time = block_st.start_time | default: '00:00'
                assign e_time = block_st.end_time | default: '23:59'
                assign start_dt = ''
                if block_st.start_date != blank
                  assign start_dt = block_st.start_date | append: 'T' | append: s_time | append: ':00' | append: tz_colon
                endif
                assign end_dt = ''
                if block_st.end_date != blank
                  assign end_dt = block_st.end_date | append: 'T' | append: e_time | append: ':59' | append: tz_colon
                endif
                # Estado inicial (aproximado, servidor) só p/ evitar flash; o JS corrige a cada segundo
                assign now_ts = 'now' | date: '%s' | plus: 0
                assign out_of_window = false
                if start_dt != blank
                  assign start_ts = start_dt | date: '%s' | plus: 0
                  if now_ts < start_ts
                    assign out_of_window = true
                  endif
                endif
                if end_dt != blank
                  assign end_ts = end_dt | date: '%s' | plus: 0
                  if now_ts > end_ts and block_st.expired_message == blank
                    assign out_of_window = true
                  endif
                endif
              -%}
              {%- if block_st.custom_colors and block_st.bg_color != blank -%}
                {%- style -%}
                  #topbar.topbar { background: {{ block_st.bg_color }} !important; }
                {%- endstyle -%}
              {%- endif -%}
              {%- capture shipping_style_vars -%}
                {%- if block_st.timer_font_size != blank -%}--topbar-shipping-timer-size: {{ block_st.timer_font_size }}px;{%- endif -%}
                {%- if block_st.custom_colors -%}
                  {%- if block_st.text_color != blank -%}--topbar-shipping-text: {{ block_st.text_color }};{%- endif -%}
                  {%- if block_st.timer_color != blank -%}--topbar-shipping-accent: {{ block_st.timer_color }};{%- endif -%}
                {%- endif -%}
              {%- endcapture -%}
              <topbar-shipping-timer
                class="topbar-item topbar-shipping{% if block_st.hidden_on_mobile %} hidden block-1025{% endif %}"
                data-start="{{ start_dt }}"
                data-end="{{ end_dt }}"
                data-expired-message="{{ block_st.expired_message | escape }}"
                {% if out_of_window %}hidden{% endif %}
                {% if shipping_style_vars != blank %}style="{{ shipping_style_vars | strip | strip_newlines }}"{% endif %}
              >
                {%- if block_st.message != blank -%}
                  <div class="topbar-shipping__message">{{ block_st.message }}</div>
                {%- endif -%}
                {%- if end_dt != blank -%}
                  <div class="topbar-shipping__timer-row">
                    {%- if block_st.label_before != blank -%}
                      <span class="topbar-shipping__label">{{ block_st.label_before | escape }}</span>
                    {%- endif -%}
                    <div class="topbar-shipping__countdown"></div>
                  </div>
                {%- endif -%}
              </topbar-shipping-timer>
            {%- when 'cur_lang' -%}
              <div class="lang__currency-desktop justify-content-center justity-md-unset topbar-item{% if block_st.hidden_on_mobile %} hidden flex-1025{% else %} flex{% endif %} flex-wrap gap-10 gap-lg-25 align-center row-gap-0">
                {%- if block_st.menu_link != blank -%}
                  <ul class="linklist list-unstyled flex flex-wrap gap-10 gap-lg-25">
                    {%- for link in block_st.menu_link.links -%}
                      <li>
                        <a class="no-underline block" href="{{ link.url }}" aria-label="{{ link.title }}">
                          {{- link.title -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {% endif %}
                {%- if block_st.show_our_store and theme_st.store_page and theme_st.store_address -%}
                  <a
                    href="{{ pages[theme_st.store_page].url | default: '#' }}"
                    aria-label="{{ theme_st.store_address }}"
                    class="no-underline"
                  >
                    {%- if theme_st.store_address != blank -%}
                      <span>{{ theme_st.store_address }}</span>
                    {%- else -%}
                      <span>{{ pages[theme_st.store_page].title }}</span>
                    {% endif %}
                  </a>
                {% endif %}
                {%- if block_st.show_currency -%}
                  {%- render 'country-switcher' -%}
                {% endif %}
                {%- if block_st.show_language -%}
                  {%- render 'language-switcher' -%}
                {% endif %}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{% endif %}
{% javascript %}
  let top_bar = document.querySelector('.section-top-bar')?.clientHeight || 0;
  const body = document.querySelector('body');
  body.style.setProperty('--height-topbar', `${top_bar}px`);

  document.querySelectorAll('#topbar .topbar-copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var coupon = btn.getAttribute('data-coupon');
      if (!coupon) return;

      navigator.clipboard.writeText(coupon).then(function() {
        btn.classList.add('is-copied');

        var msg = document.createElement('span');
        msg.className = 'topbar-copied-msg';
        msg.innerHTML = '<svg viewBox="0 0 16 16"><polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline></svg> COPIADO!';
        btn.insertAdjacentElement('afterend', msg);

        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            msg.classList.add('is-visible');
          });
        });

        setTimeout(function() {
          msg.classList.remove('is-visible');
          btn.classList.remove('is-copied');
          setTimeout(function() { msg.remove(); }, 300);
        }, 2500);
      });
    });
  });

  if (!customElements.get('topbar-shipping-timer')) {
    class TopbarShippingTimer extends HTMLElement {
      connectedCallback() {
        this.countdownEl = this.querySelector('.topbar-shipping__countdown');
        this.timerRow = this.querySelector('.topbar-shipping__timer-row');
        this.start = this.parseDate(this.dataset.start);
        this.end = this.parseDate(this.dataset.end);
        this.expiredMessage = (this.dataset.expiredMessage || '').trim();

        // Sem data de fim válida: mantém apenas a mensagem, sem contador.
        if (!this.end) {
          if (this.timerRow) this.timerRow.remove();
          this.hidden = false;
          return;
        }

        this.update = this.update.bind(this);
        this.update();
        this.interval = setInterval(this.update, 1000);
      }

      disconnectedCallback() {
        if (this.interval) clearInterval(this.interval);
      }

      parseDate(value) {
        if (!value) return null;
        var d = new Date(value);
        return isNaN(d.getTime()) ? null : d;
      }

      update() {
        var now = Date.now();

        // Ainda não começou -> esconde a barra inteira (mostra sozinha ao iniciar).
        if (this.start && now < this.start.getTime()) {
          this.hidden = true;
          return;
        }

        var diff = this.end.getTime() - now;

        // Terminou.
        if (diff <= 0) {
          if (this.interval) clearInterval(this.interval);
          if (this.expiredMessage) {
            this.hidden = false;
            if (this.timerRow) {
              this.timerRow.innerHTML =
                '<span class="topbar-shipping__expired"></span>';
              this.timerRow.firstChild.textContent = this.expiredMessage;
            }
          } else {
            this.hidden = true;
          }
          return;
        }

        this.hidden = false;
        var d = Math.floor(diff / 86400000);
        var h = Math.floor((diff / 3600000) % 24);
        var m = Math.floor((diff / 60000) % 60);
        var s = Math.floor((diff / 1000) % 60);
        var pad = function (n) { return String(n).padStart(2, '0'); };

        var segs = [];
        if (d > 0) segs.push(d);
        segs.push(h, m, s);

        if (this.countdownEl) {
          this.countdownEl.innerHTML = segs
            .map(function (v) {
              return '<span class="topbar-shipping__seg">' + pad(v) + '</span>';
            })
            .join('');
        }
      }
    }
    customElements.define('topbar-shipping-timer', TopbarShippingTimer);
  }
{% endjavascript %}
{% schema %}
{
  "name": "t:sections.top-bar.name",
  "class": "section-top-bar",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.section_width.container.label"
        },
        {
          "value": "fluid_container",
          "label": "t:sections.all.section_width.fluid_container.label"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.section_width.stretch_width.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.section_width.full_width.label"
        }
      ],
      "default": "stretch_width",
      "label": "t:sections.all.section_width.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "t:sections.top-bar.settings.show_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "show_separator_line",
      "label": "t:sections.top-bar.settings.show_separator_line.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_setting.label"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "t:sections.all.content_setting.uppercase.label"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "label": "t:sections.all.content_setting.font_size.label",
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "options": [
        {
          "value": "body_weight",

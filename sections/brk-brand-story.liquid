{%- comment -%}
  História da marca + cards expansíveis com imagens do próprio produto.
  Usado no template product.chapeu-importado (Chapéus Importados / American Hat Makers).

  Cada card escolhe a imagem assim (primeira que existir):
  1. "Imagem fixa" escolhida no editor;
  2. foto do produto cujo arquivo termina com o texto informado (ex.: -8 → ...-8.jpg);
  3. foto do produto na posição informada da galeria.
  O texto do card pode vir de um metafield do produto (ex.: brk.estrutura_conforto), com o texto do bloco como reserva.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign icon_blocks = section.blocks | where: 'type', 'icon'
  assign card_blocks = section.blocks | where: 'type', 'card'
-%}
<div
  class="section brk-story color-{{ st.color_scheme }} gradient"
  style="--brk-story-accent: {{ st.accent_color }}; --brk-story-pt: {{ st.padding_top }}px; --brk-story-pb: {{ st.padding_bottom }}px;"
>
  <div class="{{ st.section_width }}">
    {%- if icon_blocks.size > 0 -%}
      {%- assign icon_rows = icon_blocks.size | divided_by: 2.0 | ceil -%}
      <ul class="brk-story__icons" role="list" style="--brk-story-icon-rows: {{ icon_rows }};">
        {%- for block in icon_blocks -%}
          <li class="brk-story__icon-item" {{ block.shopify_attributes }}>
            <span class="brk-story__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'diamond' -%}
                  <svg viewBox="0 0 32 32" fill="currentColor"><path d="M9.2 4h13.6l6.7 8.1L16 28.6 2.5 12.1 9.2 4Z"/><path d="M2.5 12.1h27M12.3 4 9.6 12.1 16 28.6l6.4-16.5L19.7 4M9.6 12.1 16 4.6l6.4 7.5" fill="none" stroke="#fff" stroke-width="1.3" stroke-linejoin="round" opacity=".9"/></svg>
                {%- when 'hat' -%}
                  <svg viewBox="1 5 30 21" fill="currentColor"><path d="M10.6 8.4c1.4-1.2 3.3-.6 5.4.4 2.1-1 4-1.6 5.4-.4 1.5 1.3 2 5 2.1 8.6-2.4.9-4.9 1.3-7.5 1.3s-5.1-.4-7.5-1.3c.1-3.6.6-7.3 2.1-8.6Z"/><path d="M1.5 15.6c1.7-.6 3 .2 4.6 1.2 2.8 1.6 6.1 2.4 9.9 2.4s7.1-.8 9.9-2.4c1.6-1 2.9-1.8 4.6-1.2-1.1 4.6-6.6 8-14.5 8S2.6 20.2 1.5 15.6Z"/></svg>
                {%- when 'badge' -%}
                  <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 2.5l3.3 2.4 4.1-.2 1.3 3.9 3.3 2.4-1.2 3.9 1.2 3.9-3.3 2.4-1.3 3.9-4.1-.2L16 25.3l-3.3-2.4-4.1.2-1.3-3.9L4 16.8l1.2-3.9L4 9l3.3-2.4 1.3-3.9 4.1.2L16 2.5Z" transform="translate(0 2)"/><path d="m11 16.6 3.4 3.4 6.8-7.2" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 32 32" fill="currentColor"><circle cx="14" cy="14" r="11.5"/><path d="M2.5 14h23M14 2.5c3.2 3.2 4.8 7 4.8 11.5S17.2 22.3 14 25.5M14 2.5C10.8 5.7 9.2 9.5 9.2 14s1.6 8.3 4.8 11.5M4.6 7.6h18.8M4.6 20.4h18.8" fill="none" stroke="#fff" stroke-width="1.4"/><rect x="18.5" y="18.5" width="11" height="10" rx="1.2" stroke="#fff" stroke-width="1.6"/><path d="M18.5 22h11M24 18.5V22" stroke="#fff" stroke-width="1.4"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 32 32" fill="currentColor"><path d="m16 3 3.9 8.3 9.1 1.2-6.6 6.3 1.6 9L16 23.4l-8 4.4 1.6-9L3 12.5l9.1-1.2L16 3Z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 3 27 7.5v7.8c0 6.4-4.6 11.6-11 13.7C9.6 26.9 5 21.7 5 15.3V7.5L16 3Z"/><path d="m11 15.8 3.4 3.4 6.6-7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </span>
            <span class="brk-story__icon-text{% if block.settings.text_mobile != blank %} brk-story__icon-text--desktop{% endif %}">
              {{- block.settings.text | newline_to_br -}}
            </span>
            {%- if block.settings.text_mobile != blank -%}
              <span class="brk-story__icon-text brk-story__icon-text--mobile">
                {{- block.settings.text_mobile | newline_to_br -}}
              </span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if st.subheading != blank or st.heading != blank or st.text != blank -%}
      <div class="brk-story__intro">
        {%- if st.subheading != blank -%}
          <p class="brk-story__subheading">{{ st.subheading }}</p>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2 class="brk-story__heading">{{ st.heading }}</h2>
        {%- endif -%}
        {%- if st.text != blank -%}
          <div class="brk-story__text">{{ st.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_blocks.size > 0 -%}
      <div class="brk-story__cards">
        {%- for block in card_blocks -%}
          {%- liquid
            assign bs = block.settings
            assign card_image = bs.image
            if card_image == blank and product != blank
              if bs.image_match != blank
                assign match_token = bs.image_match | append: '.'
                for media in product.media
                  if media.preview_image.src contains match_token
                    assign card_image = media.preview_image
                    break
                  endif
                endfor
              endif
              if card_image == blank and bs.image_position > 0
                assign media_index = bs.image_position | minus: 1
                assign card_image = product.media[media_index].preview_image
              endif
            endif

            assign card_text = bs.text
            if bs.mf_key != blank and product != blank
              assign mf_ns = bs.mf_namespace | default: 'brk'
              assign mf_value = product.metafields[mf_ns][bs.mf_key]
              if mf_value != blank
                assign card_text = mf_value.value | newline_to_br | strip_newlines
                assign card_text = '<p>' | append: card_text | append: '</p>' | replace: '<br /><br />', '</p><p>' | replace: '<br />', ' '
              endif
            endif
          -%}
          <details class="brk-story__card" {% if bs.open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="brk-story__card-head">
              <span class="brk-story__card-media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900, 1200',
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      alt: bs.title,
                      style: bs.image_focal
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'brk-story__placeholder' }}
                {%- endif -%}
              </span>
              <span class="brk-story__card-title">
                {{ bs.title }}
                {%- if card_text != blank -%}
                  <svg class="brk-story__chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endif -%}
              </span>
            </summary>
            {%- if card_text != blank -%}
              <div class="brk-story__card-body">{{ card_text }}</div>
            {%- endif -%}
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .brk-story { padding-top: var(--brk-story-pt); padding-bottom: var(--brk-story-pb); color: var(--color-text); }
  .brk-story__icons {
    list-style: none; margin: 0 auto 4rem; padding: 0; max-width: 96rem;
    display: flex; flex-wrap: wrap; justify-content: space-evenly; align-items: center; gap: 2.4rem 4rem;
  }
  .brk-story__icon-item { display: flex; align-items: center; gap: 1.6rem; }
  .brk-story__icon {
    flex: 0 0 auto; width: 3.6rem; height: 3.6rem; color: var(--brk-story-accent);
    display: flex; align-items: center; justify-content: center; line-height: 0;
  }
  .brk-story__icon svg { width: 100%; height: 100%; display: block; }
  .brk-story__icon-text {
    font-size: 1.5rem; line-height: 1.15; text-transform: uppercase; letter-spacing: .02em;
    color: var(--brk-story-accent); text-align: left;
  }
  .brk-story__icon-text--mobile { display: none; }
  .brk-story__intro { max-width: 100rem; margin: 0 auto 4.8rem; text-align: center; }
  .brk-story__subheading { margin: 0 0 .4rem; font-size: 1.2rem; text-transform: uppercase; letter-spacing: .04em; }
  .brk-story__heading {
    margin: 0 0 2.4rem; font-size: 1.8rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .02em; color: var(--color-heading);
  }
  .brk-story__text { font-size: 1.4rem; line-height: 1.6; opacity: .85; }
  .brk-story__text p { margin: 0 0 1.6rem; }
  .brk-story__text p:last-child { margin-bottom: 0; }

  .brk-story__cards {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.8rem; align-items: start;
  }
  .brk-story__card {
    border: 1px solid rgba(var(--color-text-rgb), .22); border-radius: 8px; overflow: hidden;
    background: var(--color-background);
  }
  .brk-story__card-head { list-style: none; cursor: pointer; display: block; }
  .brk-story__card-head::-webkit-details-marker { display: none; }
  .brk-story__card-media { display: block; aspect-ratio: 1.57; overflow: hidden; background: rgba(var(--color-text-rgb), .06); }
  .brk-story__card-media img,
  .brk-story__card-media svg { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .brk-story__card-head:hover .brk-story__card-media img { transform: scale(1.03); }
  .brk-story__card-title {
    display: flex; align-items: center; justify-content: center; gap: .8rem;
    padding: 1.8rem 1.6rem; font-size: 1.4rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .03em; text-align: center; opacity: .85;
  }
  .brk-story__chevron { width: 1.2rem; height: .8rem; flex: 0 0 auto; transition: transform .25s ease; }
  .brk-story__card[open] .brk-story__chevron { transform: rotate(180deg); }
  .brk-story__card-body {
    position: relative; padding: 2rem 2.4rem 2.4rem; font-size: 1.3rem; line-height: 1.55;
    text-align: center; opacity: .8; animation: brk-story-reveal .3s ease;
  }
  .brk-story__card-body::before {
    content: ''; position: absolute; top: 0; left: 50%; width: 4.4rem; height: 1px;
    transform: translateX(-50%); background: rgba(var(--color-text-rgb), .3);
  }
  .brk-story__card-body p { margin: 0 0 1.2rem; }
  .brk-story__card-body p:last-child { margin-bottom: 0; }
  @keyframes brk-story-reveal { from { opacity: 0; transform: translateY(-4px); } to { opacity: .8; transform: none; } }

  @media (max-width: 749.98px) {
    .brk-story__icons {
      display: grid; grid-auto-flow: column;
      grid-template-columns: repeat(2, max-content);
      grid-template-rows: repeat(var(--brk-story-icon-rows, 2), auto);
      justify-content: space-between; gap: 2.4rem 2rem;
      max-width: 36rem; margin-bottom: 3.2rem;
    }
    .brk-story__icon-item { gap: 1.2rem; }
    .brk-story__icon { width: 3rem; height: 3rem; }
    .brk-story__icon-text { font-size: 1.3rem; }
    .brk-story__icon-text--desktop { display: none; }
    .brk-story__icon-text--mobile { display: block; }
    .brk-story__intro { margin-bottom: 3.2rem; }
    .brk-story__heading { font-size: 1.6rem; margin-bottom: 1.6rem; }
    .brk-story__text { font-size: 1.3rem; }
    .brk-story__cards { grid-template-columns: 1fr; gap: 2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BRK História da marca",
  "tag": "section",
  "class": "brk-story-section not-hide-br",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "options": [
        { "value": "container", "label": "t:sections.all.section_width.container.label" },
        { "value": "fluid_container", "label": "t:sections.all.section_width.fluid_container.label" },
        { "value": "stretch_width", "label": "t:sections.all.section_width.stretch_width.label" },
        { "value": "full_width", "label": "t:sections.all.section_width.full_width.label" }
      ],
      "default": "container"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "color", "id": "accent_color", "label": "Cor dos ícones", "default": "#0f294b" },
    { "type": "header", "content": "Texto" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "American Hat Makers" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tradição desde 1972" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Na AHM, os chapéus são produzidos apenas com as melhores matérias-primas do mercado, incluindo couro legítimo, palha nobre, lã e feltro de alta densidade. O catálogo da marca abrange modelos em diversos formatos, medidas e tonalidades, desenvolvidos sob medida para atender às expectativas dos clientes mais exigentes.</p><p>Cada peça é confeccionada artesanalmente de acordo com os rigorosos padrões de excelência construídos ao longo de três gerações e mais de 50 anos de história na chapelaria tradicional.</p>"
    },
    { "type": "header", "content": "Espaçamento" },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Ícone com texto",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "diamond", "label": "Diamante" },
            { "value": "hat", "label": "Chapéu" },
            { "value": "badge", "label": "Selo com check" },
            { "value": "globe", "label": "Globo (importado)" },
            { "value": "star", "label": "Estrela" },
            { "value": "shield", "label": "Escudo com check" }
          ],
          "default": "diamond"
        },
        { "type": "textarea", "id": "text", "label": "Texto", "info": "Quebre a linha para dividir em duas linhas.", "default": "Qualidade\npremium" },
        { "type": "textarea", "id": "text_mobile", "label": "Texto no mobile (opcional)", "info": "Vazio = mesmo texto do desktop." }
      ]
    },
    {
      "type": "card",
      "name": "Card expansível",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Estilo e durabilidade" },
        { "type": "richtext", "id": "text", "label": "Texto", "info": "Usado quando o produto não tem o metafield abaixo preenchido." },
        { "type": "text", "id": "mf_namespace", "label": "Metafield: namespace", "default": "brk" },
        { "type": "text", "id": "mf_key", "label": "Metafield: chave (opcional)", "info": "Ex.: estrutura_conforto. Se o produto tiver esse metafield preenchido, ele substitui o texto acima." },
        { "type": "checkbox", "id": "open", "label": "Aberto por padrão", "default": false },
        { "type": "header", "content": "Imagem" },
        { "type": "paragraph", "content": "Ordem: imagem fixa → foto do produto cujo arquivo termina com o texto → foto na posição da galeria." },
        { "type": "image_picker", "id": "image", "label": "Imagem fixa (opcional)" },
        { "type": "text", "id": "image_match", "label": "Foto do produto: arquivo termina com", "info": "Ex.: -8 usa a foto \"...-8.jpg\" de cada produto." },
        { "type": "number", "id": "image_position", "label": "Foto do produto: posição na galeria", "info": "Reserva, caso nenhuma foto combine (1 = primeira). 0 = desligado.", "default": 0 },
        {
          "type": "select",
          "id": "image_focal",
          "label": "Enquadramento",
          "options": [
            { "value": "object-position: center center;", "label": "Centro" },
            { "value": "object-position: center top;", "label": "Topo" },
            { "value": "object-position: center bottom;", "label": "Base" }
          ],
          "default": "object-position: center center;"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BRK História da marca",
      "blocks": [
        { "type": "icon", "settings": { "icon": "diamond", "text": "Qualidade\npremium" } },
        { "type": "icon", "settings": { "icon": "hat", "text": "Essência\nwestern" } },
        { "type": "icon", "settings": { "icon": "badge", "text": "De 50 anos\nde tradição" } },
        { "type": "icon", "settings": { "icon": "globe", "text": "Produto\nimportado" } },
        { "type": "card", "settings": { "title": "Estilo e durabilidade" } },
        { "type": "card", "settings": { "title": "Estrutura e conforto" } },
        { "type": "card", "settings": { "title": "Qualidade garantida" } }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Guia de medidas editável: botão "Descubra o seu tamanho" + popup.
  Posicione este bloco logo ACIMA do seletor de variantes: o botão se alinha à direita,
  na mesma linha do rótulo "Tamanho:".
{%- endcomment -%}
{%- if block.settings.brk_size_guide -%}
  <div class="brk-sg-anchor" {{ block.shopify_attributes }}>
    {%- render 'brk-size-guide', guide: block -%}
  </div>
{%- else -%}
  <div hidden {{ block.shopify_attributes }}></div>
{%- endif -%}

{% stylesheet %}
  .brk-sg-anchor { position: relative; z-index: 2; height: 0; }
  .brk-sg-anchor > .brk-sg-trigger { position: absolute; top: 0; right: 0; line-height: 1.4; }
{% endstylesheet %}

{% schema %}
{
  "name": "Guia de medidas",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Mantenha este bloco logo acima do seletor de variantes: o botão aparece à direita, na linha do rótulo \"Tamanho\"."
    },
    { "type": "checkbox", "id": "brk_size_guide", "label": "Exibir guia", "default": true },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Descubra o seu tamanho" },
    { "type": "text", "id": "popup_title", "label": "Título do popup", "default": "Guia de tamanhos" },
    { "type": "header", "content": "Cores" },
    { "type": "color", "id": "color_primary", "label": "Cor principal", "default": "#0f294b" },
    { "type": "color", "id": "color_highlight", "label": "Cor de destaque da dica", "default": "#ede5da" },
    { "type": "header", "content": "Como medir" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Descubra seu tamanho" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Ilustração",
      "info": "Vazio = ilustração padrão da cabeça com fita métrica."
    },
    { "type": "textarea", "id": "step_1", "label": "Passo 1", "default": "Utilize uma fita métrica." },
    {
      "type": "textarea",
      "id": "step_2",
      "label": "Passo 2",
      "default": "Posicione a fita ao redor da cabeça, passando logo acima das orelhas e pelo centro da testa."
    },
    {
      "type": "textarea",
      "id": "step_3",
      "label": "Passo 3",
      "default": "Anote a medida em centímetro. Esse será o tamanho ideal do seu chapéu."
    },
    { "type": "header", "content": "Dica" },
    { "type": "text", "id": "tip_label", "label": "Rótulo", "default": "Dica" },
    {
      "type": "inline_richtext",
      "id": "tip_text",
      "label": "Texto",
      "default": "Se sua medida ficar entre dois tamanhos, <strong>escolha o maior</strong> para garantir mais conforto."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Observação",
      "default": "Caso não tenha fita métrica, utilize um barbante ou cordão e meça o comprimento com uma régua."
    },
    { "type": "header", "content": "Tabela" },
    { "type": "text", "id": "col_1", "label": "Coluna 1", "default": "Tamanho" },
    { "type": "text", "id": "col_1_sub", "label": "Coluna 1 (subtítulo)", "default": "Internacional / BR" },
    { "type": "checkbox", "id": "show_flags", "label": "Mostrar bandeiras EUA/BR", "default": true },
    { "type": "text", "id": "col_2", "label": "Coluna 2", "default": "Circunferência (cm)" },
    { "type": "text", "id": "col_3", "label": "Coluna 3", "default": "Tamanho (US)" },
    {
      "type": "textarea",
      "id": "rows",
      "label": "Linhas",
      "info": "Uma linha por tamanho, colunas separadas por | (ex.: XS (PP) | 52 – 53 cm | 6 ½). A primeira palavra da coluna 1 fica em negrito.",
      "default": "XS (PP) | 52 – 53 cm | 6 ½\nSM (P) | 54 – 55 cm | 6 ⅞\nMD (M) | 56 – 57 cm | 7 ⅛\nLG (G) | 58 – 59 cm | 7 ⅜\nXL (GG) | 60 – 61 cm | 7 ⅝"
    }
  ],
  "presets": [{ "name": "Guia de medidas" }]
}
{% endschema %}

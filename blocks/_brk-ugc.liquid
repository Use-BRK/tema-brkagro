{%- comment -%}
  BRK AGRO — Reels de prova social (UGC) no buy box.
  Carrossel horizontal de vídeos verticais 9:16. Leve: preload="metadata"
  (não baixa o arquivo todo), sem autoplay em massa — toca ao clicar, 1 por vez.
  Cada item: vídeo (URL mp4) + poster opcional + produto vinculado opcional.
{%- endcomment -%}
{%- liquid
  assign st = block.settings
  assign accent = st.accent_color | default: '#085b47'
  assign count = 0
  for i in (1..6)
    assign ks = 'v' | append: i | append: '_src'
    if st[ks] != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- if count > 0 -%}
  <div class="brk-ugc" style="--brk-accent: {{ accent }};" {{ block.shopify_attributes }}>
    {%- if st.eyebrow != blank or st.heading != blank -%}
      <div class="brk-ugc__head">
        {%- if st.eyebrow != blank -%}<span class="brk-ugc__eyebrow">{{ st.eyebrow }}</span>{%- endif -%}
        {%- if st.heading != blank -%}<span class="brk-ugc__title">{{ st.heading }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="brk-ugc__row">
      {%- for i in (1..6) -%}
        {%- liquid
          assign ks = 'v' | append: i | append: '_src'
          assign kp = 'v' | append: i | append: '_poster'
          assign kpr = 'v' | append: i | append: '_product'
          assign src = st[ks]
          assign poster = st[kp]
          assign prod = st[kpr]
        -%}
        {%- if src != blank -%}
          <div class="brk-ugc__card">
            <video
              class="brk-ugc__video"
              preload="metadata"
              playsinline
              muted
              loop
              {% if poster != blank %}poster="{{ poster | image_url: width: 400 }}"{% endif %}
            >
              <source src="{{ src }}#t=0.1" type="video/mp4">
            </video>
            <button type="button" class="brk-ugc__play" aria-label="Reproduzir vídeo">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.53.85l10-6.5a1 1 0 0 0 0-1.7l-10-6.5A1 1 0 0 0 8 5.5Z"/></svg>
            </button>
            {%- if prod != blank and prod.url != blank -%}
              <a class="brk-ugc__cta" href="{{ prod.url }}">
                {{ prod.title | truncate: 28 }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
<style>
  .brk-ugc { --brk-accent: #085b47; margin-block: 1.8rem; }
  .brk-ugc__head { display: flex; flex-direction: column; gap: .2rem; margin-bottom: 1.1rem; }
  .brk-ugc__eyebrow {
    font-family: var(--body-font); font-size: 1.1rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--brk-accent); font-weight: 600;
  }
  .brk-ugc__title { font-family: var(--heading-font); font-weight: 600; font-size: 1.45rem; color: #26241d; }
  .brk-ugc__row {
    display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch; padding-bottom: .4rem;
    scrollbar-width: none;
  }
  .brk-ugc__row::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) { .brk-ugc__row { justify-content: safe center; } }
  .brk-ugc__card {
    position: relative; flex: 0 0 42%; max-width: 16rem; aspect-ratio: 9 / 16;
    border-radius: 14px; overflow: hidden; background: #14150f;
    scroll-snap-align: start; cursor: pointer; box-shadow: 0 2px 10px rgba(0,0,0,.08);
  }
  .brk-ugc__video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .brk-ugc__play {
    position: absolute; inset: 0; margin: auto; width: 4.4rem; height: 4.4rem;
    display: flex; align-items: center; justify-content: center; padding: 0;
    border: none; border-radius: 50%; background: rgba(255,255,255,.9); color: var(--brk-accent);
    cursor: pointer; transition: transform .2s ease, opacity .2s ease;
    box-shadow: 0 2px 12px rgba(0,0,0,.25);
  }
  .brk-ugc__play svg { width: 2rem; height: 2rem; margin-left: 2px; }
  .brk-ugc__card:hover .brk-ugc__play { transform: scale(1.06); }
  .brk-ugc__card.is-playing .brk-ugc__play { opacity: 0; pointer-events: none; }
  .brk-ugc__cta {
    position: absolute; left: .6rem; right: .6rem; bottom: .6rem;
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    padding: .7rem .8rem; border-radius: 9px;
    background: rgba(20,21,15,.82); color: #fff; text-decoration: none;
    font-family: var(--body-font); font-size: 1.12rem; font-weight: 600; line-height: 1.2;
    backdrop-filter: blur(4px); transition: background .2s ease;
  }
  .brk-ugc__cta svg { width: 1.4rem; height: 1.4rem; flex: 0 0 auto; }
  .brk-ugc__cta:hover { background: var(--brk-accent); }
  @media (max-width: 480px) {
    .brk-ugc__card { flex-basis: 40%; }
  }
</style>
{% javascript %}
  document.addEventListener('click', function (e) {
    var card = e.target.closest('.brk-ugc__card');
    if (!card) return;
    if (e.target.closest('.brk-ugc__cta')) return;
    var video = card.querySelector('video');
    if (!video) return;
    document.querySelectorAll('.brk-ugc__card.is-playing').forEach(function (other) {
      if (other !== card) {
        var v = other.querySelector('video');
        if (v) v.pause();
        other.classList.remove('is-playing');
      }
    });
    if (video.paused) {
      video.play();
      card.classList.add('is-playing');
    } else {
      video.pause();
      card.classList.remove('is-playing');
    }
  });
{% endjavascript %}

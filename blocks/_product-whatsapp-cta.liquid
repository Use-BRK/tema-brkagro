{% liquid
  assign block_st = block.settings
  assign product = closest.product
  assign show_button = block_st.enable_button

  comment
    Filtro opcional por collection: se nenhuma collection for selecionada, aparece em todos os produtos.
  endcomment
  assign selected_collections = block_st.collections
  assign matches_collection = true
  if selected_collections.size > 0
    assign matches_collection = false
    for selected_collection in selected_collections
      for product_collection in product.collections
        if product_collection.id == selected_collection.id
          assign matches_collection = true
          break
        endif
      endfor
      if matches_collection
        break
      endif
    endfor
  endif

  comment
    Monta a URL do WhatsApp: número + mensagem pré-preenchida (opcionalmente com o link do produto).
  endcomment
  assign wa_number = block_st.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign wa_message = block_st.whatsapp_message | default: 'Olá! Tenho interesse neste produto:'
  assign button_text = block_st.button_text | default: '[whatsapp] Comprar pelo WhatsApp'
  assign divider_text = block_st.divider_text

  assign product_url = request.origin | append: product.url
  if block_st.append_product_link
    assign wa_full_message = wa_message | append: ' ' | append: product_url
  else
    assign wa_full_message = wa_message
  endif
  assign wa_text = wa_full_message | url_encode

  if wa_number != blank
    assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
  else
    assign wa_url = 'https://api.whatsapp.com/send?text=' | append: wa_text
  endif
%}

{% if show_button and matches_collection %}
  {%- capture wa_icon -%}
    <span class="whatsapp-cta__icon" aria-hidden="true">{%- render 'icon-brk-whatsapp' -%}</span>
  {%- endcapture -%}
  {%- assign rendered_text = button_text | replace: '[whatsapp]', wa_icon -%}

  <div
    id="wa-cta-{{ block.id }}"
    class="product-detail__whatsapp-cta mb-20"
    style="--wa-color: {{ block_st.text_color | default: '#128c4a' }};"
    {% if block_st.enable_schedule %}
      data-wa-schedule="true"
      data-wa-start="{{ block_st.hours_start | default: '08:00' }}"
      data-wa-end="{{ block_st.hours_end | default: '18:00' }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if divider_text != blank -%}
      <div class="whatsapp-cta__divider"><span>{{ divider_text }}</span></div>
    {%- endif -%}
    <a
      href="{{ wa_url }}"
      target="_blank"
      rel="noopener"
      class="whatsapp-cta"
    >{{ rendered_text }}</a>
  </div>
  {% if block_st.enable_schedule %}
    <script>
      (function () {
        var wrap = document.getElementById('wa-cta-{{ block.id }}');
        if (!wrap) return;
        // No editor do tema, mantém sempre visível para conseguir editar.
        if (window.Shopify && Shopify.designMode) return;

        function toMinutes(value) {
          var m = (value || '').match(/^(\d{1,2}):(\d{2})$/);
          if (!m) return null;
          var h = parseInt(m[1], 10);
          var min = parseInt(m[2], 10);
          if (h > 23 || min > 59) return null;
          return h * 60 + min;
        }

        var start = toMinutes(wrap.getAttribute('data-wa-start'));
        var end = toMinutes(wrap.getAttribute('data-wa-end'));
        if (start === null || end === null) return; // horário inválido -> não esconde

        function update() {
          // Hora atual em UTC-3, independente do fuso do visitante.
          var now = new Date();
          var utcMs = now.getTime() + now.getTimezoneOffset() * 60000;
          var brt = new Date(utcMs - 3 * 3600000);
          var cur = brt.getHours() * 60 + brt.getMinutes();
          // Suporta janela normal (08:00-18:00) e que cruza a meia-noite (20:00-06:00).
          var open = start <= end ? (cur >= start && cur < end) : (cur >= start || cur < end);
          wrap.style.display = open ? '' : 'none';
        }

        update();
        // Revalida a cada minuto para o caso da página ficar aberta cruzando o horário.
        setInterval(update, 60000);
      })();
    </script>
  {% endif %}

  <script>
    {%- comment -%}
      Trackeamento do clique via delegação no document (vinculado uma única vez).
      Resiliente a re-render por AJAX: não perde nenhum clique.
    {%- endcomment -%}
    (function () {
      if (window.__brkWaCtaClarity) return;
      window.__brkWaCtaClarity = true;
      document.addEventListener('click', function (e) {
        var link = e.target.closest && e.target.closest('.product-detail__whatsapp-cta a');
        if (!link) return;
        try {
          if (typeof window.clarity === 'function') {
            window.clarity('event', 'whatsapp_cta_click');
          }
        } catch (err) { /* ignore */ }
      }, true);
    })();
  </script>
{% endif %}

{% stylesheet %}
  .product-detail__whatsapp-cta { text-align: center; }
  .whatsapp-cta__divider {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2rem; /* mesmo respiro do mb-20 do botão de sacola acima do divisor */
    font-size: 1.3rem;
    color: #8a8a8a;
  }
  .whatsapp-cta__divider::before,
  .whatsapp-cta__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e5e5e5;
  }
  .whatsapp-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 5.6rem; /* mesma altura do botão Adicionar à Sacola */
    box-sizing: border-box;
    padding: var(--btn-padding-y) var(--btn-padding-x);
    border: 1px solid var(--wa-color, #128c4a);
    border-radius: var(--btn-radius);
    background: transparent;
    color: var(--wa-color, #128c4a);
    font-size: var(--btn-font-size);
    font-weight: 600;
    line-height: normal;
    text-decoration: none;
    transition: var(--transition);
  }
  .whatsapp-cta:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--wa-color, #128c4a) 6%, transparent);
  }
  .whatsapp-cta:active { transform: translateY(1px) scale(0.97); }
  .whatsapp-cta * { color: inherit; }
  .whatsapp-cta__icon { display: inline-block; vertical-align: middle; line-height: 0; margin: 0 8px 0 0; }
  .whatsapp-cta__icon svg { width: 1.25em; height: 1.25em; vertical-align: middle; }
{% endstylesheet %}

{% schema %}
{
  "name": "Compre pelo WhatsApp",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_button",
      "default": true,
      "label": "Exibir bloco"
    },
    {
      "type": "text",
      "id": "divider_text",
      "default": "Ou",
      "label": "Texto do divisor",
      "info": "Aparece entre linhas acima do botão. Deixe vazio para ocultar o divisor."
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "default": "[whatsapp] Comprar pelo WhatsApp",
      "label": "Texto do botão",
      "info": "Use a barra de formatação para negrito/itálico/link. Use [whatsapp] onde quiser exibir o ícone do WhatsApp."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto e borda",
      "default": "#128c4a"
    },
    {
      "type": "header",
      "content": "Conversa"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Número do WhatsApp",
      "info": "DDI + DDD + número (ex.: 5511999999999). Vazio = abre o compartilhamento do WhatsApp."
    },
    {
      "type": "textarea",
      "id": "whatsapp_message",
      "default": "Olá! Tenho interesse neste produto:",
      "label": "Mensagem enviada"
    },
    {
      "type": "checkbox",
      "id": "append_product_link",
      "default": true,
      "label": "Adicionar link do produto à mensagem"
    },
    {
      "type": "header",
      "content": "Horário de atendimento"
    },
    {
      "type": "checkbox",
      "id": "enable_schedule",
      "default": false,
      "label": "Ativar horário",
      "info": "Quando ligado, o botão só aparece dentro do horário abaixo (fuso UTC-3, horário de Brasília). Fora do horário fica oculto automaticamente."
    },
    {
      "type": "text",
      "id": "hours_start",
      "default": "08:00",
      "label": "Início",
      "info": "Formato 24h HH:MM (ex.: 08:00)."
    },
    {
      "type": "text",
      "id": "hours_end",
      "default": "18:00",
      "label": "Fim",
      "info": "Formato 24h HH:MM (ex.: 18:00)."
    },
    {
      "type": "header",
      "content": "Exibição"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Exibir apenas nestas collections",
      "info": "Se nenhuma collection for selecionada, o bloco aparece em todos os produtos."
    }
  ],
  "presets": [
    {
      "name": "Compre pelo WhatsApp"
    }
  ]
}
{% endschema %}

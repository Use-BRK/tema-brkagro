{% doc %}
  @prompt
    divider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-divider-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.spacing_top }}px;
    padding-bottom: {{ block.settings.spacing_bottom }}px;
  }

  .ai-divider-{{ ai_gen_id }}__line {
    width: 100%;
    height: {{ block.settings.thickness }}px;
    background-color: {{ block.settings.color }};
    border: 0;
    margin: 0;
  }

  .ai-divider-{{ ai_gen_id }}__line--dashed {
    height: 0;
    background-color: transparent;
    border-top: {{ block.settings.thickness }}px dashed {{ block.settings.color }};
  }

  .ai-divider-{{ ai_gen_id }}__line--dotted {
    height: 0;
    background-color: transparent;
    border-top: {{ block.settings.thickness }}px dotted {{ block.settings.color }};
  }
{% endstyle %}

<div class="ai-divider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <hr class="ai-divider-{{ ai_gen_id }}__line ai-divider-{{ ai_gen_id }}__line--{{ block.settings.style }}" aria-hidden="true">
</div>

{% schema %}
{
  "name": "Divider",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#085B47"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Divider"
    }
  ],
  "tag": null,
  "class": "divider-block"
}
{% endschema %}
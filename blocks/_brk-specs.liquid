    { "type": "select", "id": "s1_icon", "label": "Ícone", "default": "cotton", "options": [
      {"value":"cotton","label":"Algodão"},{"value":"feather","label":"Tecido"},{"value":"dry","label":"Secagem"},{"value":"ruler","label":"Modelagem"},
      {"value":"shield","label":"Proteção"},{"value":"sun","label":"UV"},{"value":"boot","label":"Bota"},{"value":"seam","label":"Costura"},
      {"value":"medal","label":"Selo"},{"value":"refresh","label":"Cuidados"},{"value":"thermo","label":"Térmico"},{"value":"drop","label":"Repelente"},{"value":"tag","label":"Etiqueta"} ] },

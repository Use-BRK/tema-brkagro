{%- comment -%}
  BRK AGRO — "Detalhes técnicos" compacto no buy box (abaixo do trust).
  Orientado por metafields (namespace custom, SEM defaults): a linha só aparece
  se o metafield tiver valor real — vazio/ausente ou sentinela (nao/-/off) = oculta.
  Cada linha: label + ícone + chave do metafield editáveis no editor.
  custom.especificacoes (rich text) substitui a tabela inteira.
  Ex.: calças setam custom.composicao, custom.modelagem, custom.feito_para;
       camisas setam custom.tecido, custom.protecao, custom.manga.
{%- endcomment -%}
{%- liquid
  assign st = block.settings
  assign product = closest.product
  assign green = st.accent_color | default: '#085b47'
  assign ns = st.mf_namespace | default: 'brk'
  assign mf_full = product.metafields[ns].especificacoes
  assign variant = product.selected_or_first_available_variant
  assign sentinels = 'nao,não,off,false,none,no,0,-,—'

  assign has_rows = false

  comment
    Prazo de produção: tag prazo_imediato (ou custom.disponibilidade = 0) = pronta entrega;
    senão usa custom.disponibilidade (dias úteis), com fallback no prazo padrão do bloco.
  endcomment
  assign prazo_text = ''
  if st.show_prazo
    assign prazo_dias = st.prazo_padrao | default: '10' | plus: 0
    assign mf_disp = product.metafields.custom.disponibilidade
    if mf_disp != blank
      assign prazo_dias = mf_disp.value | plus: 0
    endif
    if product.tags contains 'prazo_imediato' or prazo_dias <= 0
      assign prazo_text = st.prazo_imediato_label | default: 'Pronta entrega'
    elsif prazo_dias == 1
      assign prazo_text = '1 dia útil'
    else
      assign prazo_text = prazo_dias | append: ' dias úteis'
    endif
    assign has_rows = true
  endif

  for i in (1..8)
    assign klabel = 's' | append: i | append: '_label'
    assign kval = 's' | append: i | append: '_value'
    assign kmfk = 's' | append: i | append: '_mf'
    assign label = st[klabel]
    assign value = st[kval]
    assign mfk = st[kmfk]
    if mfk != blank
      assign mv = product.metafields[ns][mfk]
      if mv != blank
        assign raw = mv.value | join: ', '
        assign raws = raw | downcase | strip
        if sentinels contains raws
          assign value = ''
        else
          assign value = raw
        endif
      endif
    endif
    if label != blank and value != blank
      assign has_rows = true
      break
    endif
  endfor
  if st.show_sku and variant.sku != blank
    assign has_rows = true
  endif
-%}
{%- if mf_full != blank or has_rows -%}
  <div class="brk-bbspecs" style="--brk-green: {{ green }};" {{ block.shopify_attributes }}>
    <details class="brk-bbspecs__acc"{% if st.open %} open{% endif %}>
      <summary class="brk-bbspecs__head">
        <span class="brk-bbspecs__title">{{ st.heading | default: 'Detalhes técnicos' }}</span>
        <span class="brk-bbspecs__toggle" aria-hidden="true"></span>
      </summary>
      {%- if mf_full != blank -%}
      <div class="brk-bbspecs__card brk-bbspecs__rte rte">{{ mf_full }}</div>
    {%- else -%}
      <dl class="brk-bbspecs__card">
        {%- if prazo_text != blank -%}
          <div class="brk-bbspecs__row brk-bbspecs__row--prazo">
            <dt class="brk-bbspecs__label">
              <span class="brk-bbspecs__icon">
                <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M15.3125 5.6875L14.4375 6.5625M2.625 18.375C2.04166 17.7917 5.47896 12.9182 12.9369 3.75463C13.2027 3.42818 13.5329 3.16005 13.907 2.96697C14.2811 2.77389 14.691 2.66 15.1111 2.63243C15.5311 2.60486 15.9524 2.66419 16.3485 2.80672C16.7446 2.94924 17.1071 3.17191 17.4133 3.46081C17.7195 3.7497 17.9629 4.09863 18.1282 4.48579C18.2935 4.87296 18.3772 5.29004 18.3741 5.71101C18.371 6.13198 18.2811 6.54778 18.1101 6.93245C17.9391 7.31713 17.6906 7.66242 17.3801 7.94675C8.12729 15.4823 3.20891 18.9583 2.625 18.375Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M14.875 6.125C12.8336 3.79137 11.8125 2.625 10.5 2.625C9.1875 2.625 8.75 3.5 8.75 4.375C8.75 7.875 15.8909 11.7302 14 14C13.076 15.1095 11.0574 15.1244 8.96875 14.707M5.02162 13.4969C3.80275 13.0025 1.75 11.8125 1.75 10.5M17.0625 8.3125L18.375 9.625" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>{{ st.prazo_label | default: 'Prazo de Produção' }}</span>
            </dt>
            <dd class="brk-bbspecs__value">{{ prazo_text }}</dd>
          </div>
        {%- endif -%}
        {%- for i in (1..8) -%}
          {%- liquid
            assign klabel = 's' | append: i | append: '_label'
            assign kval = 's' | append: i | append: '_value'
            assign kicon = 's' | append: i | append: '_icon'
            assign kmfk = 's' | append: i | append: '_mf'
            assign label = st[klabel]
            assign icon = st[kicon]
            assign mfk = st[kmfk]
            assign value = st[kval]
            if mfk != blank
              assign mv = product.metafields[ns][mfk]
              if mv != blank
                assign raw = mv.value | join: ', '
                assign raws = raw | downcase | strip
                if sentinels contains raws
                  assign value = ''
                else
                  assign value = raw
                endif
              endif
            endif
          -%}
          {%- if label != blank and value != blank -%}
            <div class="brk-bbspecs__row">
              <dt class="brk-bbspecs__label"><span class="brk-bbspecs__icon">{% render 'brk-icon', name: icon %}</span><span>{{ label }}</span></dt>
              <dd class="brk-bbspecs__value">{{ value }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if st.show_sku and variant.sku != blank -%}
          <div class="brk-bbspecs__row">
            <dt class="brk-bbspecs__label"><span class="brk-bbspecs__icon">{% render 'brk-icon', name: 'tag' %}</span><span>{{ st.sku_label | default: 'Código' }}</span></dt>
            <dd class="brk-bbspecs__value"><span class="product__sku" role="status">{{ variant.sku }}</span></dd>
          </div>
        {%- endif -%}
      </dl>
    {%- endif -%}
    </details>
  </div>
{%- endif -%}
<style>
  .brk-bbspecs { --brk-green: #085b47; margin-top: 1.6rem; }
  .brk-bbspecs__acc {
    border: 1px solid #ecebe6; border-radius: 14px; background: #fff; overflow: hidden;
  }
  .brk-bbspecs__head {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 1.4rem;
    padding: 1.5rem 1.8rem; margin: 0;
    transition: background-color .2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .brk-bbspecs__head::-webkit-details-marker { display: none; }
  .brk-bbspecs__head:hover { background: #fafaf7; }
  .brk-bbspecs__head:focus-visible { outline: 2px solid var(--brk-green); outline-offset: -2px; border-radius: 14px; }
  .brk-bbspecs__title {
    font-family: var(--heading-font); font-weight: 600; line-height: 1.2;
    font-size: 1.45rem; color: #1f2320;
  }
  .brk-bbspecs__toggle {
    position: relative; flex: 0 0 auto; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: color-mix(in srgb, var(--brk-green) 9%, #fff);
    transition: background-color .2s ease;
  }
  .brk-bbspecs__head:hover .brk-bbspecs__toggle { background: color-mix(in srgb, var(--brk-green) 15%, #fff); }
  .brk-bbspecs__toggle::before,
  .brk-bbspecs__toggle::after {
    content: ""; position: absolute; top: 50%; left: 50%;
    width: 1rem; height: 1.6px; border-radius: 2px; background: var(--brk-green);
    transform: translate(-50%, -50%);
    transition: transform .28s cubic-bezier(.25,.8,.3,1), opacity .28s ease;
  }
  .brk-bbspecs__toggle::after { transform: translate(-50%, -50%) rotate(90deg); }
  .brk-bbspecs__acc[open] .brk-bbspecs__toggle::after { transform: translate(-50%, -50%) rotate(0); opacity: 0; }
  .brk-bbspecs__card {
    margin: 0; padding: 0 1.8rem .4rem;
    animation: brk-bbspecs-reveal .3s ease;
  }
  @keyframes brk-bbspecs-reveal { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
  .brk-bbspecs__row {
    display: grid; grid-template-columns: minmax(0, 42%) minmax(0, 1fr); align-items: center; gap: 1.6rem;
    padding: 1.15rem 0; border-top: 1px solid #f0efea;
  }
  .brk-bbspecs__label {
    display: flex; align-items: center; gap: .9rem; margin: 0; min-width: 0;
    font-family: var(--body-font); font-size: 1.3rem; line-height: 1.3; color: #6f736d;
  }
  .brk-bbspecs__icon { color: var(--brk-green); line-height: 0; flex: 0 0 auto; }
  .brk-bbspecs__icon svg { width: 1.7rem; height: 1.7rem; display: block; }
  .brk-bbspecs__value {
    margin: 0; text-align: left; font-family: var(--body-font); font-weight: 600;
    font-size: 1.3rem; color: #2c2f2b; line-height: 1.35; overflow-wrap: anywhere;
  }
  .brk-bbspecs__rte { padding: 0 1.8rem 1.4rem; font-size: 1.3rem; }
  @media (max-width: 480px) {
    .brk-bbspecs__acc { border-radius: 12px; }
    .brk-bbspecs__head { padding: 1.3rem 1.4rem; }
    .brk-bbspecs__card { padding: 0 1.4rem .2rem; }
    .brk-bbspecs__rte { padding: 0 1.4rem 1.2rem; }
    .brk-bbspecs__row { grid-template-columns: minmax(0, 45%) minmax(0, 1fr); gap: 1.2rem; padding: 1.05rem 0; }
    .brk-bbspecs__label { gap: .7rem; }
    .brk-bbspecs__label, .brk-bbspecs__value { font-size: 1.24rem; }
    .brk-bbspecs__icon svg { width: 1.6rem; height: 1.6rem; }
  }
</style>
{% schema %}
{
  "name": "BRK Especificações",
  "tag": null,
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Cor de destaque", "default": "#085b47" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Detalhes técnicos" },
    { "type": "checkbox", "id": "open", "label": "Abrir expandido por padrão", "default": false },
    { "type": "text", "id": "mf_namespace", "label": "Namespace dos metafields", "default": "brk" },
    { "type": "paragraph", "content": "Mostra o Valor padrão; o metafield <namespace>.<key> do produto sobrescreve, e sentinela (nao/off/-) oculta a linha. Deixe o Valor padrão vazio para a linha só aparecer via metafield. <namespace>.especificacoes (rich text) substitui a tabela inteira." },
    { "type": "checkbox", "id": "show_sku", "label": "Mostrar código (SKU)", "default": true },
    { "type": "text", "id": "sku_label", "label": "Rótulo do SKU", "default": "Código" },

    { "type": "header", "content": "Prazo de produção (topo)" },
